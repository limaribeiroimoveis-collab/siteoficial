function apiEditarNota(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }
    const id = String(payload.id || '').trim();
    if (!id) return { ok: false, error: 'ID vazio' };

    const sh = getSheet(SHEET_NOTAS);
    const last = sh.getLastRow();
    if (last < 2) return { ok: false, error: 'Sem notas' };

    const data = sh.getRange(2, 1, last - 1, 8).getValues();
    for (let i = 0; i < data.length; i++) {
      if (String(data[i][0]) === id) {
        const row = i + 2;
        if (payload.titulo !== undefined) sh.getRange(row, 3).setValue(String(payload.titulo || '').trim());
        if (payload.texto  !== undefined) sh.getRange(row, 4).setValue(String(payload.texto || '').trim());
        if (payload.cor    !== undefined) sh.getRange(row, 5).setValue(String(payload.cor || 'amarelo').trim());
        if (payload.fixada !== undefined) sh.getRange(row, 8).setValue(payload.fixada ? 'Sim' : '');
        sh.getRange(row, 7).setValue(new Date());
        return { ok: true, id: id };
      }
    }
    return { ok: false, error: 'Nota não encontrada' };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

function apiExcluirNota(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }
    const id = String(payload.id || '').trim();
    if (!id) return { ok: false, error: 'ID vazio' };

    const sh = getSheet(SHEET_NOTAS);
    const last = sh.getLastRow();
    if (last < 2) return { ok: false, error: 'Sem notas' };

    const data = sh.getRange(2, 1, last - 1, 1).getValues();
    for (let i = data.length - 1; i >= 0; i--) {
      if (String(data[i][0]) === id) {
        sh.deleteRow(i + 2);
        return { ok: true };
      }
    }
    return { ok: false, error: 'Nota não encontrada' };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

/* =====================================================
   ✅ V24 — TRIAGEM DE CAPTAÇÃO QPREÇO
   Adiciona 4 colunas na aba CaptacoesQPreco:
     - Proprietario
     - Cidade
     - AnunciadoQA
     - Intencao
   Cria API pública nova (salvarCaptacaoQPrecoV2)
   e API admin nova (listarCaptacoesQPrecoV3)
   SEM alterar nada do que já existe.
===================================================== */

/* -----------------------------------------------------
   MIGRAÇÃO — adiciona as 4 colunas se não existirem
----------------------------------------------------- */
function migrarV24_CaptacaoTriagem() {
  const ss = getSS();
  const log = [];

  const sh = ss.getSheetByName(SHEET_CAPTACOES);
  if (!sh) {
    const msg = '⚠️ Aba CaptacoesQPreco não existe. Rode migrarV16 primeiro.';
    Logger.log(msg);
    return msg;
  }

  const novasColunas = [
    { nome: 'Proprietario', cor: '#0ea5e9' },
    { nome: 'Cidade',       cor: '#0ea5e9' },
    { nome: 'AnunciadoQA',  cor: '#dc2626' },
    { nome: 'Intencao',     cor: '#f59e0b' }
  ];

  novasColunas.forEach(col => {
    const headers = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0]
      .map(h => String(h || '').trim());
    if (headers.indexOf(col.nome) === -1) {
      const pos = sh.getLastColumn() + 1;
      sh.getRange(1, pos).setValue(col.nome)
        .setFontWeight('bold').setBackground(col.cor).setFontColor('#ffffff');
      log.push('✅ Coluna "' + col.nome + '" criada na posição ' + pos);
    } else {
      log.push('⏭ Coluna "' + col.nome + '" já existe');
    }
  });

  const msg = '🎉 Migração V24 (Triagem) concluída:\n• ' + log.join('\n• ');
  Logger.log(msg);
  return msg;
}

/* -----------------------------------------------------
   API PÚBLICA — FASE 1 COM TRIAGEM
   Aceita os 4 campos novos + os antigos.
   Mantém o retorno { ok, id } para o front usar na fase 2.
----------------------------------------------------- */
function apiSalvarCaptacaoQPrecoV2(payload) {
  try {
    const nome        = String(payload.nome || '').trim();
    const telefone    = normalizaTel(payload.telefone);
    const rua         = String(payload.rua || '').trim();
    const numero      = String(payload.numero || '').trim();
    const complemento = String(payload.complemento || '').trim();
    const bairro      = String(payload.bairro || '').trim();

    const proprietario = String(payload.proprietario || '').trim();
    const cidade       = String(payload.cidade || '').trim();
    const anunciadoQA  = String(payload.anunciadoQA || '').trim();
    const intencao     = String(payload.intencao || '').trim();

    // ---- Validações de triagem (bloqueiam no backend também) ----
    if (!proprietario) {
      return { ok: false, error: 'Informe se você é o proprietário.' };
    }
    if (!cidade) {
      return { ok: false, error: 'Informe a cidade do imóvel.' };
    }
    if (cidade !== 'Belo Horizonte' && cidade !== 'Contagem' && cidade !== 'Nova Lima') {
      return { ok: false, error: 'Atendemos apenas Belo Horizonte, Contagem e Nova Lima.' };
    }
    if (!anunciadoQA) {
      return { ok: false, error: 'Informe se o imóvel está anunciado no Quinto Andar agora.' };
    }
    if (anunciadoQA === 'sim_agora') {
      return { ok: false, error: 'Imóvel já anunciado no Quinto Andar não pode ser reavaliado.' };
    }
    if (!intencao) {
      return { ok: false, error: 'Informe sua intenção com a avaliação.' };
    }

    // ---- Validações dos campos antigos ----
    if (!nome || nome.length < 2) {
      return { ok: false, error: 'Informe seu nome completo.' };
    }
    if (!telefone || telefone.length < 10) {
      return { ok: false, error: 'Informe um telefone válido com DDD.' };
    }
    if (!rua || rua.length < 3) {
      return { ok: false, error: 'Informe o endereço do imóvel.' };
    }
    if (!numero) {
      return { ok: false, error: 'Informe o número do imóvel.' };
    }
    if (!complemento) {
      return { ok: false, error: 'Informe o complemento (ex: Apto 101, Casa...).' };
    }
    if (!bairro || bairro.length < 2) {
      return { ok: false, error: 'Informe o bairro.' };
    }

    const sh = getSheet(SHEET_CAPTACOES);
    const id = Utilities.getUuid();
    const agora = new Date();

    // Mapa nome-coluna → índice 1-based (para não depender da ordem)
    const lastCol = sh.getLastColumn();
    const headers = sh.getRange(1, 1, 1, lastCol).getValues()[0]
      .map(h => String(h || '').trim());
    const col = {};
    headers.forEach((h, i) => { col[h] = i + 1; });

    // Monta a linha respeitando a posição real de cada coluna.
    // Colunas não mapeadas ficam vazias.
    const novaLinha = new Array(lastCol).fill('');
    const set = (nomeCol, valor) => {
      if (col[nomeCol]) novaLinha[col[nomeCol] - 1] = valor;
    };

    set('ID', id);
    set('DataHora', agora);
    set('Nome', nome);
    set('Telefone', telefone);
    set('Rua', rua);
    set('Numero', numero);
    set('Complemento', complemento);
    set('Bairro', bairro);
    set('Origem', String(payload.origem || 'qpreco').trim());
    set('Navegador', String(payload.navegador || '').trim());
    set('IP', String(payload.ip || '').trim());
    set('Proprietario', proprietario);
    set('Cidade', cidade);
    set('AnunciadoQA', anunciadoQA);
    set('Intencao', intencao);

    sh.appendRow(novaLinha);

    // Histórico do cliente (se já existir) — mesmo comportamento do antigo
    try {
      const shCli = getSheet(SHEET_CLIENTES);
      const lastCli = shCli.getLastRow();
      if (lastCli >= 2) {
        const telefones = shCli.getRange(2, 1, lastCli - 1, 1).getValues();
        for (let i = 0; i < telefones.length; i++) {
          if (normalizaTel(telefones[i][0]) === telefone) {
            registrarHistoricoCliente_(
              telefone,
              'cliente',
              'preencheu QPreço (triagem)',
              'proprietario:' + proprietario + ' | cidade:' + cidade +
              ' | anunciadoQA:' + anunciadoQA + ' | intencao:' + intencao,
              'site'
            );
            atualizarDataAcao_(telefone, 'cliente');
            break;
          }
        }
      }
    } catch (e) {
      Logger.log('Aviso histórico V24: ' + e.message);
    }

    return { ok: true, id: id };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

/* -----------------------------------------------------
   ATUALIZAÇÃO DA API DE LISTAR (GESTOR) - V25.2
   Corrigido para retornar todos os campos.
----------------------------------------------------- */
function apiListarCaptacoesQPrecoV3(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }

    const sh = getSheet(SHEET_CAPTACOES);
    const last = sh.getLastRow();
    if (last < 2) return { ok: true, data: [], total: 0 };

    const lastCol = sh.getLastColumn();
    const headers = sh.getRange(1, 1, 1, lastCol).getValues()[0].map(h => String(h || '').trim());
    const idx = {};
    headers.forEach((h, i) => { idx[h] = i; });

    function pega(row, editado, original) {
      if (editado && idx[editado] !== undefined) {
        const v = String(row[idx[editado]] || '').trim();
        if (v) return v;
      }
      if (original && idx[original] !== undefined) {
        return String(row[idx[original]] || '').trim();
      }
      return '';
    }

    const data = sh.getRange(2, 1, last - 1, lastCol).getValues();
    const out = [];
    for (let i = 0; i < data.length; i++) {
      const row = data[i];
      if (!row[idx['ID']]) continue;

      const origemStr = String(row[idx['Origem']] || '');

      out.push({
        id:           String(row[idx['ID']] || ''),
        dataHora:     toISO(row[idx['DataHora']]),
        nome:         pega(row, 'NomeEditado', 'Nome') || extrairNomeOrigem_(origemStr),
        telefone:     normalizaTel(pega(row, 'TelefoneEditado', 'Telefone') || extrairTelefoneOrigem_(origemStr)),
        rua:          pega(row, 'RuaEditada', 'Rua'),
        numero:       pega(row, 'NumeroEditado', 'Numero'),
        complemento:  pega(row, 'ComplementoEditado', 'Complemento'),
        bairro:       pega(row, 'BairroEditado', 'Bairro'),
        origem:       origemStr,
        navegador:    idx['Navegador'] !== undefined ? String(row[idx['Navegador']] || '') : '',
        ip:           idx['IP'] !== undefined ? String(row[idx['IP']] || '') : '',
        concluida:    idx['Concluida'] !== undefined ? String(row[idx['Concluida']] || '') : '',
        observacoes:  idx['Observacoes'] !== undefined ? String(row[idx['Observacoes']] || '') : '',
        contatoFeito: idx['ContatoFeito'] !== undefined ? String(row[idx['ContatoFeito']] || '') : '',
        atendidoPor:  idx['AtendidoPor'] !== undefined ? String(row[idx['AtendidoPor']] || '') : '',
        
        // Fase 1 (Triagem)
        proprietario: idx['Proprietario'] !== undefined ? String(row[idx['Proprietario']] || '') : '',
        cidade:       idx['Cidade']       !== undefined ? String(row[idx['Cidade']] || '') : '',
        anunciadoQA:  idx['AnunciadoQA']  !== undefined ? String(row[idx['AnunciadoQA']] || '') : '',
        intencao:     idx['Intencao']     !== undefined ? String(row[idx['Intencao']] || '') : '',
        
        // Fase 2 (Dados do Imóvel) - Agora lendo todas as colunas limpas

/* =====================================================
   BUSCAR IMAGEM
===================================================== */
function apiBuscarImagem(url) {
  try {
    if (!url) return { ok: false, error: 'URL vazia' };

    const resp = UrlFetchApp.fetch(url, {
      muteHttpExceptions: true, followRedirects: true, validateHttpsCertificates: false,
      headers: {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36',
        'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
        'Accept-Language': 'pt-BR,pt;q=0.9,en;q=0.8'
      }
    });
    const code = resp.getResponseCode();
    if (code >= 400) return { ok: false, error: 'HTTP ' + code };
    const html = resp.getContentText();

    let m = html.match(/<meta[^>]+property=["']og:image(?::secure_url)?["'][^>]*content=["']([^"']+)["']/i)
         || html.match(/<meta[^>]+content=["']([^"']+)["'][^>]*property=["']og:image(?::secure_url)?["']/i);
    if (!m) m = html.match(/<meta[^>]+name=["']twitter:image["'][^>]*content=["']([^"']+)["']/i)
             || html.match(/<meta[^>]+content=["']([^"']+)["'][^>]*name=["']twitter:image["']/i);
    if (!m) m = html.match(/<link[^>]+rel=["']image_src["'][^>]+href=["']([^"']+)["']/i);
    if (!m) {
      const jm = html.match(/"image"\s*:\s*"([^"]+\.(?:jpg|jpeg|png|webp|avif)[^"]*)"/i);
      if (jm) m = [null, jm[1]];
    }
    if (!m) m = html.match(/<img[^>]+src=["']([^"']+\.(?:jpg|jpeg|png|webp|avif)[^"']*)["']/i);

    if (m && m[1]) {
      let img = m[1].trim();
      if (img.startsWith('//')) img = 'https:' + img;
      else if (img.startsWith('/')) {
        const base = url.match(/^(https?:\/\/[^\/]+)/);
        if (base) img = base[1] + img;
      }
      img = img.replace(/&amp;/g, '&');
      return { ok: true, imagem: img };
    }
    return { ok: false, error: 'Nenhuma imagem encontrada' };
  } catch (err) { return { ok: false, error: err.message }; }
}


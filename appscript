/* =====================================================
   ✅ V18 — EDITAR IMÓVEL EM MASSA (por código)
   Atualiza TODOS os imóveis que tenham o mesmo código,
   em todos os clientes que o possuírem.
   Exige senha de admin.
===================================================== */
function apiAtualizarImovelPorCodigo(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }

    const codigo = String(payload.codigo || '').trim();
    if (!codigo) return { ok: false, error: 'Código do imóvel não informado' };

    const sh = getSheet(SHEET_IMOVEIS);
    const last = sh.getLastRow();
    if (last < 2) return { ok: false, error: 'Sem imóveis cadastrados' };

    const lastCol = sh.getLastColumn();
    const data = sh.getRange(2, 1, last - 1, lastCol).getValues();

    // Campos editáveis em massa:
    const novosCampos = {
      rua:         payload.rua !== undefined ? String(payload.rua || '').trim() : null,
      numero:      payload.numero !== undefined ? String(payload.numero || '').trim() : null,
      bairro:      payload.bairro !== undefined ? String(payload.bairro || '').trim() : null,
      preco:       payload.preco !== undefined ? String(payload.preco || '').trim() : null,
      condominio:  payload.condominio !== undefined ? String(payload.condominio || '').trim() : null,
      iptu:        payload.iptu !== undefined ? String(payload.iptu || '').trim() : null,
      descricao:   payload.descricao !== undefined ? String(payload.descricao || '') : null,
      link:        payload.link !== undefined ? String(payload.link || '').trim() : null,
      imagem:      payload.imagem !== undefined ? String(payload.imagem || '').trim() : null,
      chaveTexto:  payload.chaveTexto !== undefined ? String(payload.chaveTexto || '').trim() : null,
      vendido:     payload.vendido !== undefined ? (payload.vendido === true || payload.vendido === 'true' ? 'Sim' : '') : null // ← NOVO
    };

    // Recalcula o título se rua/numero/bairro foram alterados
    function montarTitulo_(r, n, b) {
      let t = String(r || '').trim();
      if (n) t += (t ? ', ' : '') + String(n).trim();
      if (b) t += (t ? ' - ' : '') + String(b).trim();
      return t;
    }

    const agora = new Date();
    const atualizados = [];
    const erros = [];

    for (let i = 0; i < data.length; i++) {
      const row = data[i];
      if (!row[0]) continue;
      const codigoAtual = String(row[9] || '').trim();
      if (codigoAtual !== codigo) continue;

      try {
        const rowIndex = i + 2;

        const ruaNova     = novosCampos.rua        !== null ? novosCampos.rua        : String(row[19] || '');
        const numeroNovo  = novosCampos.numero     !== null ? novosCampos.numero     : String(row[20] || '');
        const bairroNovo  = novosCampos.bairro     !== null ? novosCampos.bairro     : String(row[21] || '');
        const tituloNovo  = montarTitulo_(ruaNova, numeroNovo, bairroNovo) || String(row[2] || '');

        const linhaAtual = sh.getRange(rowIndex, 1, 1, lastCol).getValues()[0];

        if (novosCampos.descricao  !== null) linhaAtual[3]  = novosCampos.descricao;
        if (novosCampos.link       !== null) linhaAtual[4]  = novosCampos.link;
        if (novosCampos.imagem     !== null) linhaAtual[5]  = novosCampos.imagem;
        linhaAtual[2] = tituloNovo;
        linhaAtual[17] = agora;
        if (novosCampos.chaveTexto !== null) linhaAtual[18] = novosCampos.chaveTexto;
        linhaAtual[19] = ruaNova;
        linhaAtual[20] = numeroNovo;
        linhaAtual[21] = bairroNovo;
        if (novosCampos.preco      !== null) linhaAtual[22] = novosCampos.preco;
        if (novosCampos.condominio !== null) linhaAtual[23] = novosCampos.condominio;
        if (novosCampos.iptu       !== null) linhaAtual[24] = novosCampos.iptu;
        if (novosCampos.vendido    !== null) linhaAtual[25] = novosCampos.vendido; // ← NOVO

        sh.getRange(rowIndex, 1, 1, lastCol).setValues([linhaAtual]);

        const telCliente = normalizaTel(row[1]);
        if (telCliente) {
          registrarHistoricoCliente_(
            telCliente,
            'admin',
            'editou imóvel em massa',
            tituloNovo + ' #' + codigo,
            'admin'
          );
          atualizarDataAcao_(telCliente, 'admin');
        }

        atualizados.push({
          id: String(row[0]),
          telefone: telCliente,
          titulo: tituloNovo
        });
      } catch (e) {
        erros.push({ linha: i + 2, erro: e.message });
      }
    }

    if (atualizados.length === 0) {
      return { ok: false, error: 'Nenhum imóvel encontrado com esse código' };
    }

    return {
      ok: true,
      total: atualizados.length,
      atualizados: atualizados,
      erros: erros
    };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

/* =====================================================
   ✅ V19 — CUTUCADA MELHORADA (Layout: Data|Texto)
   Já funciona com o formato atual "Data|Texto",
   mas vamos expor um endpoint específico para
   atualizar apenas a data e o texto separadamente.
===================================================== */

/**
 * Retorna a última cutucada formatada (data + texto)
 * para exibir no card do cliente.
 * Formato do campo "Cutucada": "DataISO|Texto"
 */
function apiObterUltimaCutucada(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }
    const tel = normalizaTel(payload.telefone);
    if (!tel) return { ok: false, error: 'Telefone vazio' };

    const sh = getSheet(SHEET_CLIENTES);
    const last = sh.getLastRow();
    if (last < 2) return { ok: true, data: null };

    const lastCol = sh.getLastColumn();
    const headers = sh.getRange(1, 1, 1, lastCol).getValues()[0]
      .map(h => String(h || '').trim());
    const idx = headers.indexOf('Cutucada');
    if (idx === -1) return { ok: true, data: null };

    const data = sh.getRange(2, 1, last - 1, lastCol).getValues();
    for (let i = 0; i < data.length; i++) {
      if (normalizaTel(data[i][0]) === tel) {
        const raw = String(data[i][idx] || '').trim();
        if (!raw) return { ok: true, data: null };
        const p = raw.indexOf('|');
        if (p < 0) return { ok: true, data: null };
        const dataIso = raw.slice(0, p).trim();
        const texto = raw.slice(p + 1).trim();
        return {
          ok: true,
          data: { dataIso: dataIso, texto: texto }
        };
      }
    }
    return { ok: true, data: null };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}


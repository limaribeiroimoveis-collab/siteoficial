        setVal('Quartos', payload.quartos !== undefined ? String(payload.quartos) : undefined);
        setVal('Suites', payload.suites !== undefined ? String(payload.suites) : undefined);
        setVal('Banheiros', payload.banheiros !== undefined ? String(payload.banheiros) : undefined);

/* =====================================================
   ✅ V22 — ATUALIZAR CAPTAÇÃO (versão final)
   Aceita TODOS os campos editáveis + validações.
   Substitui completamente o apiAtualizarCaptacao antigo.
===================================================== */
function apiAtualizarCaptacao(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }
    const id = String(payload.id || '').trim();
    if (!id) return { ok: false, error: 'ID vazio' };

    const sh = getSheet(SHEET_CAPTACOES);
    const last = sh.getLastRow();
    if (last < 2) return { ok: false, error: 'Sem captações' };

    const lastCol = sh.getLastColumn();
    const headers = sh.getRange(1, 1, 1, lastCol).getValues()[0]
      .map(h => String(h || '').trim());

    // Mapa nome-coluna → índice 1-based
    const col = {};
    headers.forEach((h, i) => { col[h] = i + 1; });

    // Descobre a linha da captação
    const ids = sh.getRange(2, 1, last - 1, 1).getValues();
    let linha = -1;
    for (let i = 0; i < ids.length; i++) {
      if (String(ids[i][0]) === id) { linha = i + 2; break; }
    }
    if (linha < 0) return { ok: false, error: 'Captação não encontrada' };

    // Lê a linha atual para validar transições e preservar valores
    const linhaAtual = sh.getRange(linha, 1, 1, lastCol).getValues()[0];
    const valorAtual = (nomeCol) => col[nomeCol] ? String(linhaAtual[col[nomeCol] - 1] || '').trim() : '';

    const contatoAtual = valorAtual('ContatoFeito');
    const atendidoAtual = valorAtual('AtendidoPor');

    // ─────────────────────────────────────────────
    // 1) Atualizar contatoFeito (status) — com validação
    // ─────────────────────────────────────────────
    if (payload.contatoFeito !== undefined) {
      const novoStatus = String(payload.contatoFeito || '').trim().toLowerCase();
      const statusValidos = ['', 'sem-retorno', 'concluida', 'concluída'];
      if (!statusValidos.includes(novoStatus)) {
        return { ok: false, error: 'Status inválido: ' + novoStatus };
      }

      // Normaliza "concluída" → "concluida"
      const statusFinal = (novoStatus === 'concluída') ? 'concluida' : novoStatus;

      // ✅ Validação: sem-retorno e concluida exigem corretor
      if ((statusFinal === 'sem-retorno' || statusFinal === 'concluida')) {
        const corretorQueVaiFicar = (payload.atendidoPor !== undefined)
          ? String(payload.atendidoPor || '').trim()
          : atendidoAtual;
        if (!corretorQueVaiFicar) {
          return { ok: false, error: 'Atribua um corretor antes de marcar como "' + statusFinal + '".' };
        }
      }

      if (col['ContatoFeito']) {
        sh.getRange(linha, col['ContatoFeito']).setValue(statusFinal);
      }
    }

    // ─────────────────────────────────────────────
    // 2) Atualizar corretor (atendidoPor)
    // ─────────────────────────────────────────────
    if (payload.atendidoPor !== undefined && col['AtendidoPor']) {
      const novoCorretor = String(payload.atendidoPor || '').trim();

      // ✅ Se está tirando o corretor mas o status atual exige um → bloqueia
      if (!novoCorretor) {
        const statusDepois = (payload.contatoFeito !== undefined)
          ? String(payload.contatoFeito || '').trim().toLowerCase()
          : contatoAtual.toLowerCase();
        if (statusDepois === 'sem-retorno' || statusDepois === 'concluida' || statusDepois === 'concluída') {
          return { ok: false, error: 'Não é possível remover o corretor de uma captação com status "' + statusDepois + '".' };
        }
      }

      sh.getRange(linha, col['AtendidoPor']).setValue(novoCorretor);
    }

    // ─────────────────────────────────────────────
    // 3) Observações
    // ─────────────────────────────────────────────
    if (payload.observacoes !== undefined && col['Observacoes']) {
      sh.getRange(linha, col['Observacoes']).setValue(String(payload.observacoes || ''));
    }

    // ─────────────────────────────────────────────
    // 4) Edição dos dados do cliente/imóvel
    //    Prioriza colunas "*Editado"; se não existirem, cai pras originais
    // ─────────────────────────────────────────────
    const mapaEdicao = [
      { campo: 'nome',         editada: 'NomeEditado',       original: 'Nome' },
      { campo: 'telefone',     editada: 'TelefoneEditado',   original: 'Telefone', normalizar: true },
      { campo: 'rua',          editada: 'RuaEditada',        original: 'Rua' },
      { campo: 'numero',       editada: 'NumeroEditado',     original: 'Numero' },
      { campo: 'complemento',  editada: 'ComplementoEditado',original: 'Complemento' },
      { campo: 'bairro',       editada: 'BairroEditado',     original: 'Bairro' },
      { campo: 'tipo',         editada: 'TipoEditado',       original: null },
      { campo: 'area',         editada: 'AreaEditada',       original: null },
      { campo: 'valorEstimado',editada: 'ValorEditado',      original: null }
    ];

    let houveEdicao = false;

    mapaEdicao.forEach(m => {
      if (payload[m.campo] === undefined) return;
      let valor = String(payload[m.campo] || '').trim();
      if (m.normalizar) valor = normalizaTel(valor);

      // Se a coluna "*Editada" existir, grava lá (não mexe no original)
      if (m.editada && col[m.editada]) {
        sh.getRange(linha, col[m.editada]).setValue(valor);
        houveEdicao = true;
      }
      // Se não existir coluna editada mas existir a original e for um campo
      // que faz sentido sobrescrever (ex: nome, telefone), sobrescreve a original
      else if (m.original && col[m.original] && ['nome','telefone','rua','numero','complemento','bairro'].includes(m.campo)) {
        sh.getRange(linha, col[m.original]).setValue(valor);
        houveEdicao = true;
      }
    });

    // ─────────────────────────────────────────────
    // 5) Marca data da edição (se houve edição de dados)
    // ─────────────────────────────────────────────
    if (houveEdicao && col['EditadoEm']) {
      sh.getRange(linha, col['EditadoEm']).setValue(new Date());
    }

    return { ok: true, id: id };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

/* =====================================================
   ✅ V22 — LISTAR CAPTAÇÕES (versão final)
   Aplica fallback: se o campo "*Editado" tem valor, ele
   vence. Senão, usa o valor da coluna original.
   Assim, o frontend sempre recebe o dado "efetivo".
===================================================== */
function apiListarCaptacoesQPrecoV2(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }

    const sh = getSheet(SHEET_CAPTACOES);
    const last = sh.getLastRow();
    if (last < 2) return { ok: true, data: [] };

    const lastCol = sh.getLastColumn();
    const headers = sh.getRange(1, 1, 1, lastCol).getValues()[0]
      .map(h => String(h || '').trim());

    const idx = {};
    headers.forEach((h, i) => { idx[h] = i; });

    // Helper: pega valor respeitando fallback editado→original
    function pega(row, editado, original) {
      if (editado && idx[editado] !== undefined) {
        const v = String(row[idx[editado]] || '').trim();
        if (v) return v;
      }
      if (original && idx[original] !== undefined) {
        return String(row[idx[original]] || '').trim();
      }
      return '';
    }

    const data = sh.getRange(2, 1, last - 1, lastCol).getValues();
    const out = [];
    for (let i = 0; i < data.length; i++) {
      const row = data[i];
      if (!row[0]) continue;

      // Se não houver coluna editada, usa a origem como fallback pra endereço
      const origemStr = String(row[idx['Origem']] || '');

      out.push({
        id:           String(row[idx['ID']] || ''),
        dataHora:     toISO(row[idx['DataHora']]),
        nome:         pega(row, 'NomeEditado', 'Nome') || extrairNomeOrigem_(origemStr),
        telefone:     normalizaTel(pega(row, 'TelefoneEditado', 'Telefone') || extrairTelefoneOrigem_(origemStr)),
        rua:          pega(row, 'RuaEditada', 'Rua'),
        numero:       pega(row, 'NumeroEditado', 'Numero'),
        complemento:  pega(row, 'ComplementoEditado', 'Complemento'),
        bairro:       pega(row, 'BairroEditado', 'Bairro'),

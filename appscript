/* =====================================================
   ✅ V14.2 — ATUALIZAR CUTUCADA EXISTENTE
   Permite editar o texto de uma cutucada já salva.
===================================================== */
function apiAtualizarCutucada(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }
    const id = String(payload.id || '').trim();
    const novoTexto = String(payload.texto || '').trim();
    if (!id) return { ok: false, error: 'ID vazio' };
    if (!novoTexto) return { ok: false, error: 'Escreva a cutucada' };

    // 1) Atualiza na aba Cutucadas (histórico)
    const shCut = getSheet(SHEET_CUTUCADAS);
    const lastCut = shCut.getLastRow();
    if (lastCut < 2) return { ok: false, error: 'Sem cutucadas' };

    const dados = shCut.getRange(2, 1, lastCut - 1, 6).getValues();
    let linhaAchada = -1;
    let telefoneAchado = '';
    let dataHoraAchada = null;

    for (let i = 0; i < dados.length; i++) {
      if (String(dados[i][0]) === id) {
        linhaAchada = i + 2;
        telefoneAchado = normalizaTel(dados[i][1]);
        dataHoraAchada = dados[i][3];
        break;
      }
    }

    if (linhaAchada < 0) return { ok: false, error: 'Cutucada não encontrada' };

    // Atualiza o texto (coluna 3 = "Texto")
    shCut.getRange(linhaAchada, 3).setValue(novoTexto);

    // 2) Se essa cutucada for a ÚLTIMA do cliente, atualiza também a coluna
    //    "Cutucada" na aba Clientes (que guarda a última em formato Data|Texto)
    if (telefoneAchado && dataHoraAchada) {
      const shCli = getSheet(SHEET_CLIENTES);
      const lastCli = shCli.getLastRow();
      if (lastCli >= 2) {
        const lastColCli = shCli.getLastColumn();
        const headersCli = shCli.getRange(1, 1, 1, lastColCli).getValues()[0]
          .map(h => String(h || '').trim());
        const colCutucada = headersCli.indexOf('Cutucada') + 1;
        if (colCutucada > 0) {
          const telefones = shCli.getRange(2, 1, lastCli - 1, 1).getValues();
          const valoresCutucada = shCli.getRange(2, colCutucada, lastCli - 1, 1).getValues();

          for (let i = 0; i < telefones.length; i++) {
            if (normalizaTel(telefones[i][0]) !== telefoneAchado) continue;
            // Compara o timestamp salvo com o da cutucada editada
            const resumo = String(valoresCutucada[i][0] || '').trim();
            if (!resumo) continue;
            const idxPipe = resumo.indexOf('|');
            if (idxPipe < 0) continue;
            const dataIsoResumo = resumo.slice(0, idxPipe);
            const dResumo = new Date(dataIsoResumo);
            const dAchada = new Date(dataHoraAchada);
            if (isNaN(dResumo.getTime()) || isNaN(dAchada.getTime())) continue;
            // Mesmo minuto? Então é a mesma cutucada
            if (Math.abs(dResumo.getTime() - dAchada.getTime()) < 60 * 1000) {
              shCli.getRange(i + 2, colCutucada).setValue(
                toISO(dAchada) + '|' + novoTexto
              );
              break;
            }
          }
        }
      }
    }

    return { ok: true, id };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

/* =====================================================
   ✅ V15 — LISTAR IMÓVEIS PÚBLICOS (sem senha)
   Usada pelo site imoveis.html (vitrine pública).
   - Não exige senha
   - Filtra: desativados e vendidos
   - Remove dados sensíveis
   - Agrupa por código (evita duplicatas)
===================================================== */
function apiListarImoveisPublicos(payload) {
  try {
    const sh = getSheet(SHEET_IMOVEIS);
    const last = sh.getLastRow();
    if (last < 2) return { ok: true, data: [], total: 0 };

    const data = sh.getRange(2, 1, last - 1, 27).getValues();
    const grupos = {};

    function isSim(valor) {
      if (valor === true) return true;
      if (valor === false || valor === null || valor === undefined) return false;
      const s = String(valor).trim().toLowerCase();
      if (!s) return false;
      return s === 'sim' || s === 's' || s === 'yes' || s === 'y' ||
             s === 'true' || s === 't' || s === '1' || s === 'x' ||
             s === 'vendido' || s === 'v';
    }

    for (let i = 0; i < data.length; i++) {
      const row = data[i];
      if (!row[0]) continue;

      const codigo = String(row[9] || '').trim();
      if (!codigo) continue;

      const desativado = isSim(row[16]);
      const vendido    = isSim(row[25]);

      // ✅ Só pula desativados. Vendidos passam e são sinalizados abaixo.
      if (desativado) continue;

      const chave = 'cod:' + codigo;
      if (!grupos[chave]) {
        const chaveTexto = String(row[18] || '');
        grupos[chave] = {
          id: String(row[0]),
          codigo: codigo,
          titulo: String(row[2] || ''),
          descricao: String(row[3] || ''),
          link: String(row[4] || ''),
          imagem: String(row[5] || ''),
          status: String(row[6] || 'pendente'),
          dataCadastro: toISO(row[8]),
          rua: String(row[19] || ''),
          numero: String(row[20] || ''),
          bairro: String(row[21] || ''),
          preco: String(row[22] || ''),
          condominio: String(row[23] || ''),
          iptu: String(row[24] || ''),
          apto: extrairNumeroAptoDoChave_(chaveTexto),
          vendido: vendido ? 'Sim' : '',   // ✅ NOVO — passa o campo
          ocorrencias: 1
        };
      } else {
        // Se qualquer linha do grupo estiver vendida, marca o grupo como vendido
        if (vendido) grupos[chave].vendido = 'Sim';
        grupos[chave].ocorrencias++;
      }
    }

    const out = Object.values(grupos);
    out.sort((a, b) => new Date(b.dataCadastro) - new Date(a.dataCadastro));

    return { ok: true, data: out, total: out.length };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

    const sh = getSheet(SHEET_CLIENTES);
    const last = sh.getLastRow();
    if (last < 2) return;
    const col = quem === 'admin' ? 12 : 11;
    const telefones = sh.getRange(2, 1, last - 1, 1).getValues();
    for (let i = 0; i < telefones.length; i++) {
      if (normalizaTel(telefones[i][0]) === tel) {
        sh.getRange(i + 2, col).setValue(new Date());
        return;
      }
    }
  } catch (e) { Logger.log('Erro atualizar data ação: ' + e.message); }
}

/* =====================================================
   SAÍDA
===================================================== */
function jsonOut(obj, callback) {
  const json = JSON.stringify(obj);
  if (callback && /^[A-Za-z_$][A-Za-z0-9_$]*$/.test(callback)) {
    return ContentService
      .createTextOutput(callback + '(' + json + ');')
      .setMimeType(ContentService.MimeType.JAVASCRIPT);
  }
  return ContentService
    .createTextOutput(json)
    .setMimeType(ContentService.MimeType.JSON);
}


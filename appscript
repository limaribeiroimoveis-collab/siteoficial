function apiListarNotificacoes(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }

    const sh = getSheet(SHEET_IMOVEIS);
    const last = sh.getLastRow();
    if (last < 2) return { ok: true, data: { gostei: [], visita: [] } };

    const data = sh.getRange(2, 1, last - 1, 26).getValues();
    const gostei = [], visita = [];

    for (let i = 0; i < data.length; i++) {
      const row = data[i];
      if (!row[0]) continue;
      const status    = String(row[6] || '').toLowerCase();
      const atendidoG = String(row[13] || '').toLowerCase() === 'sim';
      const atendidoV = String(row[14] || '').toLowerCase() === 'sim';
      const desativado = String(row[16] || '').toLowerCase() === 'sim';
      if (desativado) continue;

      const temAgendamento = !!row[15];
      const visitaFeita    = String(row[12] || '').toLowerCase() === 'sim';

      const item = {
        id: String(row[0]), telefone: String(row[1] || ''),
        titulo: String(row[2] || ''), link: String(row[4] || ''),
        imagem: String(row[5] || ''), status: String(row[6] || ''),
        observacao: String(row[7] || ''), codigo: String(row[9] || ''),
        dataCadastro: toISO(row[8])
      };

      if (status === 'gostei' && !atendidoG) gostei.push(item);
      if (status === 'quero-visitar' && !atendidoV && !temAgendamento && !visitaFeita) visita.push(item);
    }

    const sortFn = (a, b) => new Date(b.dataCadastro || 0) - new Date(a.dataCadastro || 0);
    gostei.sort(sortFn);
    visita.sort(sortFn);
    return { ok: true, data: { gostei, visita } };
  } catch (err) { return { ok: false, error: err.message }; }
}


          sh.getRange(row, 13).setValue(valor);
          sh.getRange(row, 14).setValue('Sim');
        }
        registrarHistoricoCliente_(tel, 'admin', 'definiu temperatura manual',
          valor === 'automatico' ? 'voltou ao automático' : 'temperatura: ' + valor, 'admin');
        atualizarDataAcao_(tel, 'admin');

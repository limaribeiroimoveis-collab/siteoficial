// Lista todas as cutucadas de um cliente (mais recentes primeiro)
function apiListarCutucadas(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }
    const tel = normalizaTel(payload.telefone);
    if (!tel) return { ok: false, error: 'Telefone vazio' };

    const sh = getSheet(SHEET_CUTUCADAS);
    const last = sh.getLastRow();
    if (last < 2) return { ok: true, data: [] };

    const data = sh.getRange(2, 1, last - 1, 6).getValues();
    const out = [];
    for (let i = 0; i < data.length; i++) {
      const row = data[i];
      if (normalizaTel(row[1]) !== tel) continue;
      out.push({
        id: String(row[0]),
        telefone: String(row[1]),
        texto: String(row[2] || ''),
        dataHora: toISO(row[3]),
        origem: String(row[4] || ''),
        apelido: String(row[5] || '')
      });
    }
    out.sort((a, b) => new Date(b.dataHora) - new Date(a.dataHora));
    return { ok: true, data: out };
  } catch (err) { return { ok: false, error: err.message }; }
}

// Adiciona uma nova cutucada
function apiAdicionarCutucada(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }
    const tel = normalizaTel(payload.telefone);
    const texto = String(payload.texto || '').trim();
    if (!tel) return { ok: false, error: 'Telefone vazio' };
    if (!texto) return { ok: false, error: 'Escreva a cutucada' };

    // Salva na aba Cutucadas
    const shCut = getSheet(SHEET_CUTUCADAS);
    const id = Utilities.getUuid();
    const agora = new Date();
    shCut.appendRow([id, tel, texto, agora, 'admin', 'admin']);

    // Atualiza coluna "Cutucada" na aba Clientes (só com o resumo mais recente)
    const shCli = getSheet(SHEET_CLIENTES);
    const lastCli = shCli.getLastRow();
    if (lastCli >= 2) {
      const colCutucada = shCli.getLastColumn();
      const telefones = shCli.getRange(2, 1, lastCli - 1, 1).getValues();
      for (let i = 0; i < telefones.length; i++) {
        if (normalizaTel(telefones[i][0]) === tel) {
          // Formato: "DataHora|Texto" (vamos quebrar no frontend)
          const resumo = toISO(agora) + '|' + texto;
          shCli.getRange(i + 2, colCutucada).setValue(resumo);
          break;
        }
      }
    }

    // Histórico
    registrarHistoricoCliente_(tel, 'admin', 'enviou cutucada', texto.substring(0, 80), 'admin');

    return { ok: true, id, dataHora: toISO(agora) };
  } catch (err) { return { ok: false, error: err.message }; }
}
/* =====================================================
   ✅ V14.1 — SALVAR IMÓVEL COM CORRETOR + STATUS
   Substitui o apiSalvarImovel para:
   - Aceitar o campo "corretor" do payload
   - Salvar o corretor na coluna 27 (nova)
   - Manter o status atual se estiver editando
===================================================== */
function apiSalvarImovelComCorretor(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }

    const sh = getSheet(SHEET_IMOVEIS);
    const id = payload.id || Utilities.getUuid();
    const tel = normalizaTel(payload.telefone || '');
    const codigo = extrairCodigoImovel(payload.link || '');
    const link = String(payload.link || '');

    const rua = String(payload.rua || '').trim();
    const numero = String(payload.numero || '').trim();
    const bairro = String(payload.bairro || '').trim();
    const tituloFinal = montarTitulo_(rua, numero, bairro) || String(payload.titulo || '').trim();

    const last = sh.getLastRow();
    let rowIndex = -1;
    let rowAntiga = null;

    if (last >= 2) {
      const ids = sh.getRange(2, 1, last - 1, 1).getValues();
      for (let i = 0; i < ids.length; i++) {
        if (String(ids[i][0]) === String(id)) {
          rowIndex = i + 2;
          rowAntiga = sh.getRange(rowIndex, 1, 1, sh.getLastColumn()).getValues()[0];
          break;
        }
      }
    }

    if (rowIndex < 0 && tel) {
      if (last >= 2) {
        const dados = sh.getRange(2, 1, last - 1, 10).getValues();
        for (let i = 0; i < dados.length; i++) {
          const r = dados[i];
          if (!r[0]) continue;
          if (normalizaTel(r[1]) !== tel) continue;
          const codigoExist = String(r[9] || '').trim();
          const linkExist = String(r[4] || '').trim();
          const codigoBate = codigo && codigoExist && codigo === codigoExist;
          const linkBate = link && linkExist && link === linkExist;
          if (codigoBate || linkBate) {
            return {
              ok: false,
              error: 'Você já colocou este imóvel na vitrine deste cliente antes. Não é possível adicionar novamente.'
            };
          }
        }
      }
    }

    // ✅ Mantém o status ao editar
    const statusFinal = payload.status || (rowAntiga ? rowAntiga[6] : 'pendente');

    // ✅ Corretor: prioridade para o que veio no payload
    //    Se não veio, mantém o que já existia (coluna 27)
    const corretorFinal = payload.corretor
      || (rowAntiga ? String(rowAntiga[26] || '') : '');

    const rowData = [
      id, tel, tituloFinal,
      payload.descricao || '',
      link,
      payload.imagem || '',
      statusFinal,
      payload.observacao || '',
      rowAntiga ? rowAntiga[8]  : new Date(),
      codigo,
      rowAntiga ? rowAntiga[10] : '',
      rowAntiga ? rowAntiga[11] : '',
      rowAntiga ? rowAntiga[12] : 'Não',
      rowAntiga ? rowAntiga[13] : '',
      rowAntiga ? rowAntiga[14] : '',
      rowAntiga ? rowAntiga[15] : '',
      rowAntiga ? rowAntiga[16] : '',
      new Date(),
      payload.chaveTexto || (rowAntiga ? rowAntiga[18] : ''),
      rua, numero, bairro,
      payload.preco || '',
      payload.condominio || '',
      payload.iptu || '',
      rowAntiga ? rowAntiga[25] : '',
      corretorFinal
    ];

    if (rowIndex > 0) {
      sh.getRange(rowIndex, 1, 1, rowData.length).setValues([rowData]);
    } else {
      sh.appendRow(rowData);
    }

    registrarHistoricoImovel_(id, rowIndex > 0 ? 'imóvel editado' : 'imóvel adicionado', tel, 'admin');
    if (tel) {
      registrarHistoricoCliente_(tel, 'admin',
        rowIndex > 0 ? 'editou imóvel' : 'adicionou imóvel',
        (tituloFinal || '') + (codigo ? ' #' + codigo : ''), 'admin');
      atualizarDataAcao_(tel, 'admin');
    }
    return { ok: true, id, codigo };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

/* =====================================================
   ✅ V14.1 — LISTAR CLIENTES COM CUTUCADA + ÚLTIMO ACESSO
   Inclui:
     - cutucada (última cutucada salva)
     - dataUltimoAcesso (último login do CLIENTE, ignora admin)
     - dispositivoAcesso (navegador do último login do cliente)
     - dispositivoAcao (mesmo navegador — usado quando a última
                        coisa foi uma ação, não um acesso)
===================================================== */
function apiListarClientesComCutucada(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }
    const sh = getSheet(SHEET_CLIENTES);
    const last = sh.getLastRow();
    if (last < 2) return { ok: true, data: [] };

    const lastCol = sh.getLastColumn();
    const headers = sh.getRange(1, 1, 1, lastCol).getValues()[0]
      .map(h => String(h || '').trim());
    const colCutucada = headers.indexOf('Cutucada');

    // ---- Contadores de imóveis/visitas ----
    const contadores = {};
    const shIm = getSheet(SHEET_IMOVEIS);
    const lastIm = shIm.getLastRow();
    if (lastIm >= 2) {
      const dadosIm = shIm.getRange(2, 1, lastIm - 1, 13).getValues();
      dadosIm.forEach(row => {
        if (!row[0]) return;
        const telIm = normalizaTel(row[1]);
        if (!telIm) return;
        if (!contadores[telIm]) contadores[telIm] = { imoveis: 0, visitas: 0 };
        contadores[telIm].imoveis++;
        if (String(row[12] || '').toLowerCase() === 'sim') contadores[telIm].visitas++;
      });
    }

    // ---- ✅ Último acesso do CLIENTE (ignora Admin) ----
    // Estrutura: { telefone: { data: Date, navegador: string } }
    const ultimoAcessoPorTel = {};
    try {
      const shLog = getSheet(SHEET_LOG_ACESSOS);
      const lastLog = shLog.getLastRow();
      if (lastLog >= 2) {
        // Colunas: 0=ID, 1=Telefone, 2=AcessoID, 3=Apelido, 4=DataHora,
        //          5=Navegador, 6=Modo, 7=TipoAcesso
        const dadosLog = shLog.getRange(2, 1, lastLog - 1, 8).getValues();
        dadosLog.forEach(row => {
          const tel = normalizaTel(row[1]);
          if (!tel) return;

          // ✅ Filtra: só aceita TipoAcesso = 'Cliente'
          const tipo = String(row[7] || '').trim().toLowerCase();
          if (tipo !== 'cliente') return;

          const dt = row[4] ? new Date(row[4]) : null;
          if (!dt || isNaN(dt.getTime())) return;

          const navegador = String(row[5] || '').trim();

          if (!ultimoAcessoPorTel[tel] || dt > ultimoAcessoPorTel[tel].data) {
            ultimoAcessoPorTel[tel] = { data: dt, navegador: navegador };
          }
        });
      }
    } catch (e) {
      Logger.log('Aviso: não foi possível ler LogAcessos — ' + e.message);
    }

    // ---- Monta o retorno ----
    const data = sh.getRange(2, 1, last - 1, lastCol).getValues();
    const out = [];
    for (let i = 0; i < data.length; i++) {
      const row = data[i];
      if (!row[0]) continue;
      const tel = normalizaTel(row[0]);
      const cont = contadores[tel] || { imoveis: 0, visitas: 0 };
      const temp = temperaturaDoCliente_(tel, row);
      const ultAcesso = ultimoAcessoPorTel[tel] || null;

      out.push({
        telefone: tel,
        nome: String(row[1] || ''),
        corretor: String(row[2] || ''),
        parceria: String(row[3] || ''),
        tqc: String(row[4] || ''),
        car: String(row[5] || ''),
        inativo: String(row[6] || ''),
        linkVitrine: String(row[7] || ''),
        observacao: String(row[8] || ''),
        dataCadastro: toISO(row[9]),
        dataUltimaAcaoCliente: toISO(row[10]),
        dataUltimaAcaoAdmin: toISO(row[11]),
        // ✅ Campos novos — só do cliente
        dataUltimoAcesso: ultAcesso ? toISO(ultAcesso.data) : '',
        dispositivoAcesso: ultAcesso ? ultAcesso.navegador : '',
        dispositivoAcao: ultAcesso ? ultAcesso.navegador : '',
        temperatura: temp.temperatura,
        temperaturaManual: temp.manual,
        totalImoveis: cont.imoveis,
        totalVisitasConcluidas: cont.visitas,
        cutucada: colCutucada >= 0 ? String(row[colCutucada] || '') : ''
      });
    }
    return { ok: true, data: out };
  } catch (err) { return { ok: false, error: err.message }; }
}


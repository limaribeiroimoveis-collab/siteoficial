/* -----------------------------------------------------
   ATUALIZAÇÃO DA API PÚBLICA (FASE 1)
   Recebe os novos campos e grava nas colunas da planilha.
----------------------------------------------------- */
function apiSalvarCaptacaoQPrecoV2(payload) {
  try {
    const nome        = String(payload.nome || '').trim();
    const telefone    = normalizaTel(payload.telefone);
    const rua         = String(payload.rua || '').trim();
    const numero      = String(payload.numero || '').trim();
    const complemento = String(payload.complemento || '').trim();
    const bairro      = String(payload.bairro || '').trim();

    const proprietario = String(payload.proprietario || '').trim();
    const cidade       = String(payload.cidade || '').trim();
    const anunciadoQA  = String(payload.anunciadoQA || '').trim();
    const intencao     = String(payload.intencao || '').trim();

    // Validações de triagem
    if (!proprietario) return { ok: false, error: 'Informe se você é o proprietário.' };
    if (!cidade) return { ok: false, error: 'Informe a cidade do imóvel.' };
    if (cidade !== 'Belo Horizonte' && cidade !== 'Contagem' && cidade !== 'Nova Lima') {
      return { ok: false, error: 'Atendemos apenas Belo Horizonte, Contagem e Nova Lima.' };
    }
    if (!anunciadoQA) return { ok: false, error: 'Informe se o imóvel está anunciado no Quinto Andar agora.' };
    if (anunciadoQA === 'sim_agora') {
      return { ok: false, error: 'Imóvel já anunciado no Quinto Andar não pode ser reavaliado.' };
    }
    if (!intencao) return { ok: false, error: 'Informe sua intenção com a avaliação.' };

    // Validações dos campos antigos
    if (!nome || nome.length < 2) return { ok: false, error: 'Informe seu nome completo.' };
    if (!telefone || telefone.length < 10) return { ok: false, error: 'Informe um telefone válido com DDD.' };
    if (!rua || rua.length < 3) return { ok: false, error: 'Informe o endereço do imóvel.' };
    if (!numero) return { ok: false, error: 'Informe o número do imóvel.' };
    if (!complemento) return { ok: false, error: 'Informe o complemento (ex: Apto 101, Casa...).' };
    if (!bairro || bairro.length < 2) return { ok: false, error: 'Informe o bairro.' };

    const sh = getSheet(SHEET_CAPTACOES);
    const id = Utilities.getUuid();
    const agora = new Date();

    const lastCol = sh.getLastColumn();
    const headers = sh.getRange(1, 1, 1, lastCol).getValues()[0].map(h => String(h || '').trim());
    const col = {};
    headers.forEach((h, i) => { col[h] = i + 1; });

    // Monta a linha baseada no nome da coluna (dinâmico)
    const novaLinha = new Array(lastCol).fill('');
    const set = (nomeCol, valor) => { if (col[nomeCol]) novaLinha[col[nomeCol] - 1] = valor; };

    set('ID', id);
    set('DataHora', agora);
    set('Nome', nome);
    set('Telefone', telefone);
    set('Rua', rua);
    set('Numero', numero);
    set('Complemento', complemento);
    set('Bairro', bairro);
    set('Origem', String(payload.origem || 'qpreco').trim());
    set('Navegador', String(payload.navegador || '').trim());
    set('IP', String(payload.ip || '').trim());
    
    set('Proprietario', proprietario);
    set('Cidade', cidade);
    set('AnunciadoQA', anunciadoQA);
    set('Intencao', intencao);

    sh.appendRow(novaLinha);

    // Histórico do cliente
    try {
      const shCli = getSheet(SHEET_CLIENTES);
      const lastCli = shCli.getLastRow();
      if (lastCli >= 2) {
        const telefones = shCli.getRange(2, 1, lastCli - 1, 1).getValues();
        for (let i = 0; i < telefones.length; i++) {
          if (normalizaTel(telefones[i][0]) === telefone) {
            registrarHistoricoCliente_(
              telefone, 'cliente', 'preencheu QPreço (triagem)',
              'proprietario:' + proprietario + ' | cidade:' + cidade + ' | anunciadoQA:' + anunciadoQA + ' | intencao:' + intencao,
              'site'
            );
            atualizarDataAcao_(telefone, 'cliente');
            break;
          }
        }
      }
    } catch (e) { Logger.log('Aviso histórico V25: ' + e.message); }

    return { ok: true, id: id };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}


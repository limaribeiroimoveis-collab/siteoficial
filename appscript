function doGet(e) {
  const p = (e && e.parameter) ? e.parameter : {};
  const callback = p.callback || null;
  const action = p.action;
  if (!action) {
    return HtmlService.createHtmlOutput(
      '<div style="font-family:sans-serif;padding:40px;text-align:center">' +
      '<h2>🏢 Lima Ribeiro Imóveis</h2><p>API ativa (v13).</p></div>'
    );
  }
  let result;
  try { result = executarAcao(action, p); }
  catch (err) { result = { ok: false, error: err.message }; }
  return jsonOut(result, callback);
}

function doPost(e) {
  try {
    const body = (e && e.postData && e.postData.contents) ? JSON.parse(e.postData.contents) : {};
    const action = body.action;
    if (!action) {
      return ContentService.createTextOutput(JSON.stringify({ ok: false, error: 'Ação não informada' }))
        .setMimeType(ContentService.MimeType.JSON);
    }
    let result;
    try { result = executarAcao(action, body); }
    catch (err) { result = { ok: false, error: err.message }; }

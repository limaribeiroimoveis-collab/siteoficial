function apiCriarEventoNeutro(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }
    const titulo = String(payload.titulo || '').trim();
    const descricao = String(payload.descricao || '').trim();
    const dataHora = String(payload.dataHora || '').trim();
    const corretor = String(payload.corretor || '').trim();

    if (!titulo) return { ok: false, error: 'Informe o título do evento' };
    if (!dataHora) return { ok: false, error: 'Informe a data e hora' };
    if (!corretor) return { ok: false, error: 'Escolha o corretor' };

    const dt = new Date(dataHora);
    if (isNaN(dt.getTime())) return { ok: false, error: 'Data/hora inválida' };

    const sh = getSheet(SHEET_EVENTOS);
    const id = Utilities.getUuid();
    sh.appendRow([id, titulo, descricao, dt, corretor, new Date(), 'admin']);

    return { ok: true, id };
  } catch (err) {
    return { ok: false, error: err.message };
  }

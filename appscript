 * Função principal que inicia o processo.
 * Roda todo dia às 3h (Seg-Sex) e Sábado às 23h.
 */
function iniciarVerificacaoNoturna() {
  const ss = getSS();
  
  // 1. Cria ou limpa a aba de controle
  let shCont = ss.getSheetByName(SHEET_CONTROLE);
  if (!shCont) {
    shCont = ss.insertSheet(SHEET_CONTROLE);
  }
  
  // Força a recriação do cabeçalho e dos valores iniciais
  shCont.clear();
  shCont.getRange(1, 1, 1, 2).setValues([['Chave', 'Valor']]);
  shCont.getRange(2, 1, 2, 2).setValues([['ultimaLinhaDiaria', '2'], ['ultimaLinhaSabado', '2']]);
  shCont.getRange(1, 1, 1, 2).setFontWeight('bold');

  // 2. Define qual rotina vai rodar hoje (Sábado ou Diário)
  const hoje = new Date();
  const isSabado = hoje.getDay() === 6; // 6 = Sábado
  const chaveControle = isSabado ? 'ultimaLinhaSabado' : 'ultimaLinhaDiaria';

  // 3. Dispara o primeiro lote
  processarLoteVerificacao(chaveControle);
}

/**
 * Processa 35 imóveis por vez para não estourar o tempo.
 */
function processarLoteVerificacao(chaveControle) {
  const ss = getSS();
  const shCont = ss.getSheetByName('ControleVerificacao');
  const shIm = getSheet(SHEET_IMOVEIS);
  const last = shIm.getLastRow();
  
  const dadosControle = shCont.getRange(1, 1, shCont.getLastRow(), 2).getValues();
  let linhaControle = -1;
  let linhaAtual = 2;
  for(let i=0; i<dadosControle.length; i++){
    if(dadosControle[i][0] === chaveControle){ 
      linhaControle = i+1; 
      linhaAtual = parseInt(dadosControle[i][1]) || 2; 
      break; 
    }
  }

  if (linhaAtual > last) {
    Logger.log('🎉 Verificação concluída! Todos os lotes processados.');
    return;
  }

  const isSabado = (chaveControle === 'ultimaLinhaSabado');
  const TAMANHO_LOTE = 30; 
  const limiteLote = Math.min(linhaAtual + TAMANHO_LOTE - 1, last);
  
  const numLinhas = limiteLote - linhaAtual + 1;
  const data = shIm.getRange(linhaAtual, 1, numLinhas, 26).getValues();
  
  let novosVendidos = 0;
  let reativados = 0;

  for (let i = 0; i < data.length; i++) {
    const row = data[i];
    const id = String(row[0]);
    const link = String(row[4] || '').trim();
    const desativado = String(row[16] || '').toLowerCase() === 'sim';
    const vendidoAtual = String(row[25] || '').toLowerCase() === 'sim';

    if (desativado || !link) continue;
    if (!isSabado && vendidoAtual) continue; // Seg-Sex pula os já marcados como vendidos

    const paginaCaiu = verificarLinkQuintoAndarVendido_(link);
    const linhaReal = linhaAtual + i;
    
    if (paginaCaiu && !vendidoAtual) {
      shIm.getRange(linhaReal, 26).setValue('Sim');
      registrarHistoricoImovel_(id, 'marcado como vendido (auto)', row[1], 'sistema');
      novosVendidos++;
    } else if (!paginaCaiu && vendidoAtual) {
      shIm.getRange(linhaReal, 26).setValue('');
      registrarHistoricoImovel_(id, 'reativado (auto)', row[1], 'sistema');
      reativados++;
    }

    Utilities.sleep(1500); 
  }

  shCont.getRange(linhaControle, 2).setValue(limiteLote + 1);
  Logger.log(`Lote (linhas ${linhaAtual} a ${limiteLote}). Vendidos: ${novosVendidos}, Reativados: ${reativados}.`);

  if (limiteLote < last) {
    ScriptApp.getProjectTriggers().forEach(t => {
      if (t.getHandlerFunction() === 'continuarLoteVerificacao') ScriptApp.deleteTrigger(t);
    });
    
    ScriptApp.newTrigger('continuarLoteVerificacao')
      .timeBased()
      .after(2 * 60 * 1000) // Rápido: 2 minutos
      .create();
  } else {
    Logger.log('🎉 Todos os lotes foram processados com sucesso!');
  }
}

/**
 * Ponte para o gatilho de 5 minutos.
 */
function continuarLoteVerificacao() {
  const shCont = getSS().getSheetByName(SHEET_CONTROLE);
  const dados = shCont.getRange(1, 1, shCont.getLastRow(), 2).getValues();
  let chave = 'ultimaLinhaDiaria';
  
  const ultimaSabado = parseInt(dados.find(r => r[0] === 'ultimaLinhaSabado')[1]);
  const ultimaDiaria = parseInt(dados.find(r => r[0] === 'ultimaLinhaDiaria')[1]);
  const total = getSheet(SHEET_IMOVEIS).getLastRow();

  if (ultimaSabado > 2 && ultimaSabado <= total) chave = 'ultimaLinhaSabado';
  else if (ultimaDiaria > 2 && ultimaDiaria <= total) chave = 'ultimaLinhaDiaria';

  // Limpa gatilhos antigos de 5 min para não acumular
  ScriptApp.getProjectTriggers().forEach(t => {
    if (t.getHandlerFunction() === 'continuarLoteVerificacao') ScriptApp.deleteTrigger(t);
  });

  processarLoteVerificacao(chave);
}

/**
 * Instala os gatilhos. Rode esta função UMA VEZ.
 */
function instalarGatilhosV28() {
  // Limpa todos os gatilhos antigos
  ScriptApp.getProjectTriggers().forEach(t => ScriptApp.deleteTrigger(t));

  // 1. Todo dia às 3h da manhã inicia a verificação diária
  ScriptApp.newTrigger('iniciarVerificacaoNoturna')
    .timeBased().everyDays(1).atHour(3).create();

  // 2. Todo sábado às 23h inicia a verificação de reativação
  ScriptApp.newTrigger('iniciarVerificacaoNoturna')
    .timeBased().onWeekDay(ScriptApp.WeekDay.SATURDAY).atHour(23).create();

  Logger.log('Gatilhos V28 instalados.');
  return "Gatilhos V28 instalados!";
}


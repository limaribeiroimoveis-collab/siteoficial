===================================================== */
function registrarLogAcesso_(telefone, acessoId, apelido, navegador, modo, tipoAcesso) {
  try {
    const tel = normalizaTel(telefone);
    if (!tel) return;
    const sh = getSheet(SHEET_LOG_ACESSOS);
    sh.appendRow([
      Utilities.getUuid(),
      tel,
      String(acessoId || ''),
      String(apelido || ''),
      new Date(),
      String(navegador || ''),
      String(modo || 'token'),
      String(tipoAcesso || 'Cliente')
    ]);
    limitarLogAcessos_(tel);
  } catch (e) { Logger.log('Erro registrarLogAcesso_: ' + e.message); }
}

function limitarLogAcessos_(telefone) {
  try {
    const tel = normalizaTel(telefone);
    const sh = getSheet(SHEET_LOG_ACESSOS);
    const last = sh.getLastRow();
    if (last < 2) return;
    const dados = sh.getRange(2, 1, last - 1, 8).getValues();
    const linhas = [];
    dados.forEach((row, i) => {
      if (normalizaTel(row[1]) === tel) linhas.push({ idx: i + 2, data: row[4] });
    });
    if (linhas.length <= LIMITE_LOG_ACESSOS) return;
    linhas.sort((a, b) => new Date(b.data) - new Date(a.data));
    linhas.slice(LIMITE_LOG_ACESSOS).map(x => x.idx).sort((a,b) => b-a).forEach(r => sh.deleteRow(r));
  } catch (e) { Logger.log('Erro limitarLogAcessos_: ' + e.message); }
}


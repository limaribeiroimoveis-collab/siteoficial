    if (last < 2) return { ok: true, data: null };

    const data = sh.getRange(2, 1, last - 1, 14).getValues();
    for (let i = 0; i < data.length; i++) {
      if (normalizaTel(data[i][0]) === tel) {
        const row = data[i];
        const bairrosStr = String(row[1] || '').trim();
        return {
          ok: true,
          data: {
            telefone: tel,
            bairros: bairrosStr ? bairrosStr.split('|').map(b => b.trim()).filter(Boolean) : [],
            precoMin: String(row[2] || ''),
            precoMax: String(row[3] || ''),
            condMin: String(row[4] || ''),
            condMax: String(row[5] || ''),
            quartos: String(row[6] || ''),
            suites: String(row[7] || ''),
            vagas: String(row[8] || ''),
            acessibilidade: String(row[9] || 'tanto faz'),
            elevador: String(row[10] || 'tanto faz'),
            tipo: String(row[11] || 'tanto faz'),
            outros: String(row[12] || ''),
            dataAtualizacao: toISO(row[13])
          }
        };
      }
    }
    return { ok: true, data: null };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

/* -----------------------------------------------------
   BUSCA AVANÇADA — cruza preferências com clientes
   Retorna clientes que BATEREM com TODOS os filtros preenchidos.
   Filtro vazio = ignora.
----------------------------------------------------- */
function apiBuscaAvancadaClientes(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }

    // Normaliza filtros
    const filtroBairros = Array.isArray(payload.bairros)
      ? payload.bairros.map(b => String(b).trim().toLowerCase()).filter(Boolean)
      : String(payload.bairros || '').split(',').map(b => b.trim().toLowerCase()).filter(Boolean);

    const precoBusca     = parseFloat(String(payload.preco || '').replace(/\D/g, '')) || null;
    const condBusca      = parseFloat(String(payload.condominio || '').replace(/\D/g, '')) || null;
    const quartosBusca   = String(payload.quartos || '').trim();
    const suitesBusca    = String(payload.suites || '').trim();
    const vagasBusca     = String(payload.vagas || '').trim();
    const acessoBusca    = String(payload.acessibilidade || 'tanto faz').trim().toLowerCase();
    const elevBusca      = String(payload.elevador || 'tanto faz').trim().toLowerCase();
    const tipoBusca      = String(payload.tipo || 'tanto faz').trim().toLowerCase();
    const outrosBusca    = String(payload.outros || '').trim().toLowerCase();

    // Lê clientes
    const shCli = getSheet(SHEET_CLIENTES);
    const lastCli = shCli.getLastRow();
    if (lastCli < 2) return { ok: true, data: [], total: 0 };

    const clientes = shCli.getRange(2, 1, lastCli - 1, shCli.getLastColumn()).getValues();
    const headersCli = shCli.getRange(1, 1, 1, shCli.getLastColumn()).getValues()[0]
      .map(h => String(h || '').trim());
    const colCutucada = headersCli.indexOf('Cutucada');

    // Lê preferências
    const shPref = getSheet(SHEET_PREFERENCIAS);
    const lastPref = shPref.getLastRow();
    const prefsMap = {};
    if (lastPref >= 2) {
      const prefs = shPref.getRange(2, 1, lastPref - 1, 14).getValues();
      prefs.forEach(p => {
        const tel = normalizaTel(p[0]);
        if (!tel) return;
        prefsMap[tel] = {
          bairros: String(p[1] || '').split('|').map(b => b.trim().toLowerCase()).filter(Boolean),
          precoMin: parseFloat(String(p[2] || '').replace(/\D/g, '')) || 0,
          precoMax: parseFloat(String(p[3] || '').replace(/\D/g, '')) || 0,
          condMin:  parseFloat(String(p[4] || '').replace(/\D/g, '')) || 0,
          condMax:  parseFloat(String(p[5] || '').replace(/\D/g, '')) || 0,
          quartos: String(p[6] || '').trim(),
          suites: String(p[7] || '').trim(),
          vagas: String(p[8] || '').trim(),
          acessibilidade: String(p[9] || 'tanto faz').trim().toLowerCase(),
          elevador: String(p[10] || 'tanto faz').trim().toLowerCase(),
          tipo: String(p[11] || 'tanto faz').trim().toLowerCase(),
          outros: String(p[12] || '').trim().toLowerCase()
        };
      });
    }

    const out = [];
    clientes.forEach(row => {
      const tel = normalizaTel(row[0]);
      if (!tel) return;
      const pref = prefsMap[tel];
      if (!pref) return; // sem preferências cadastradas, não entra na busca avançada

      // =====================================================
      // ✅ BAIRROS: pelo menos 1 dos bairros buscados deve estar
      //             na lista do cliente (com "includes" bidirecional)
      // =====================================================
      if (filtroBairros.length > 0) {
        const bate = filtroBairros.some(b => pref.bairros.some(pb => pb.includes(b) || b.includes(pb)));
        if (!bate) return;
      }

      // =====================================================
      // ✅ PREÇO: se min/max em branco, aceita qualquer coisa
      //    Se ambos em branco → ignora (aceita tudo)
      // =====================================================
      if (precoBusca !== null) {
        const temMin = pref.precoMin > 0;
        const temMax = pref.precoMax > 0;
        if (temMin || temMax) {
          const min = temMin ? pref.precoMin : 0;
          const max = temMax ? pref.precoMax : Number.MAX_SAFE_INTEGER;
          if (precoBusca < min || precoBusca > max) return;
        }
      }

      // =====================================================
      // ✅ CONDOMÍNIO: mesma lógica
      // =====================================================
      if (condBusca !== null) {
        const temMin = pref.condMin > 0;
        const temMax = pref.condMax > 0;
        if (temMin || temMax) {
          const min = temMin ? pref.condMin : 0;
          const max = temMax ? pref.condMax : Number.MAX_SAFE_INTEGER;
          if (condBusca < min || condBusca > max) return;
        }
      }

      // =====================================================
      // ✅ QUARTOS: se cliente diz "2+" e busca "4" → 4 ≥ 2 ✅
      //    Se cliente tem "tanto faz" (vazio) → aceita qualquer coisa
      // =====================================================
      if (quartosBusca) {
        const qBusca = parseInt(quartosBusca);
        const qCli = parseInt(pref.quartos);
        if (!isNaN(qBusca)) {
          if (!isNaN(qCli)) {
            if (qBusca < qCli) return;
          }
        }
      }

      // =====================================================
      // ✅ SUÍTES: mesma lógica
      // =====================================================
      if (suitesBusca) {
        const sBusca = parseInt(suitesBusca);
        const sCli = parseInt(pref.suites);
        if (!isNaN(sBusca)) {
          if (!isNaN(sCli)) {
            if (sBusca < sCli) return;
          }
        }
      }

      // =====================================================
      // ✅ VAGAS: mesma lógica
      // =====================================================
      if (vagasBusca) {
        const vBusca = parseInt(vagasBusca);
        const vCli = parseInt(pref.vagas);
        if (!isNaN(vBusca)) {
          if (!isNaN(vCli)) {
            if (vBusca < vCli) return;
          }
        }
      }

      // =====================================================
      // ✅ ACESSIBILIDADE: se cliente marcou "tanto faz", aceita tudo
      // =====================================================
      if (acessoBusca !== 'tanto faz' && acessoBusca !== '') {
        if (pref.acessibilidade !== 'tanto faz' && pref.acessibilidade !== acessoBusca) return;
      }

      // =====================================================
      // ✅ ELEVADOR: mesma lógica
      // =====================================================
      if (elevBusca !== 'tanto faz' && elevBusca !== '') {
        if (pref.elevador !== 'tanto faz' && pref.elevador !== elevBusca) return;
      }

      // =====================================================
      // ✅ TIPO: mesma lógica
      // =====================================================
      if (tipoBusca !== 'tanto faz' && tipoBusca !== '') {
        if (pref.tipo !== 'tanto faz' && pref.tipo !== tipoBusca) return;
      }

      // =====================================================
      // ✅ OUTROS (texto livre): busca por substring
      // =====================================================
      if (outrosBusca) {
        if (!pref.outros.includes(outrosBusca)) return;
      }

      out.push({
        telefone: tel,
        nome: String(row[1] || ''),
        corretor: String(row[2] || ''),
        temperatura: temperaturaDoCliente_(tel, row).temperatura,
        cutucada: colCutucada >= 0 ? String(row[colCutucada] || '') : '',
        preferencias: pref
      });
    });

    out.sort((a, b) => (a.nome || '').localeCompare(b.nome || '', 'pt-BR'));
    return { ok: true, data: out, total: out.length };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

/* -----------------------------------------------------
   NOTAS POR CORRETOR — CRUD
----------------------------------------------------- */
function apiListarNotas(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }
    const corretor = String(payload.corretor || '').trim();
    if (!corretor) return { ok: false, error: 'Corretor vazio' };

    const sh = getSheet(SHEET_NOTAS);
    const last = sh.getLastRow();
    if (last < 2) return { ok: true, data: [] };

    const data = sh.getRange(2, 1, last - 1, 8).getValues();
    const out = [];
    for (let i = 0; i < data.length; i++) {
      const row = data[i];
      if (!row[0]) continue;
      if (String(row[1] || '').trim() !== corretor) continue;
      out.push({
        id: String(row[0]),
        corretor: String(row[1] || ''),
        titulo: String(row[2] || ''),
        texto: String(row[3] || ''),
        cor: String(row[4] || 'amarelo'),
        dataCriacao: toISO(row[5]),
        dataEdicao: toISO(row[6]),
        fixada: String(row[7] || '').toLowerCase() === 'sim'
      });
    }

    // Fixadas primeiro, depois mais recentes
    out.sort((a, b) => {
      if (a.fixada !== b.fixada) return a.fixada ? -1 : 1;
      const da = new Date(a.dataEdicao || a.dataCriacao).getTime();
      const db = new Date(b.dataEdicao || b.dataCriacao).getTime();
      return db - da;
    });

    return { ok: true, data: out };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}


   ✅ MIGRAÇÃO V14 — CUTUCADAS
   Cria:
   - Coluna "Cutucada" na aba Clientes (última cutucada)
   - Aba "Cutucadas" (histórico completo)
   - Endpoints: listarCutucadas, adicionarCutucada
===================================================== */
const SHEET_CUTUCADAS = 'Cutucadas';

function migrarV14() {
  const ss = getSS();
  const log = [];

  // ---- 1. Coluna "Cutucada" na aba Clientes ----
  const shCli = ss.getSheetByName(SHEET_CLIENTES);
  if (shCli) {
    const lastCol = shCli.getLastColumn();
    const headers = shCli.getRange(1, 1, 1, lastCol).getValues()[0]
      .map(h => String(h || '').trim());
    if (headers.indexOf('Cutucada') === -1) {
      shCli.getRange(1, lastCol + 1).setValue('Cutucada')
        .setFontWeight('bold').setBackground('#0ea5e9').setFontColor('#ffffff');
      log.push('Coluna "Cutucada" criada na aba Clientes');
    } else {
      log.push('Coluna "Cutucada" já existe');
    }
  }

  // ---- 2. Aba "Cutucadas" (histórico) ----
  let shCut = ss.getSheetByName(SHEET_CUTUCADAS);
  if (!shCut) {
    shCut = ss.insertSheet(SHEET_CUTUCADAS);
    const headers = ['ID', 'Telefone', 'Texto', 'DataHora', 'Origem', 'Apelido'];
    shCut.getRange(1, 1, 1, headers.length).setValues([headers])
      .setFontWeight('bold').setBackground('#0ea5e9').setFontColor('#ffffff');
    shCut.setFrozenRows(1);
    log.push('Aba "Cutucadas" criada');
  } else {
    log.push('Aba "Cutucadas" já existe');
  }

  const msg = '✅ Migração V14 concluída:\n• ' + log.join('\n• ');
  Logger.log(msg);
  return msg;
}


===================================================== */
function resolverAcesso(telefone, deviceToken) {
  if (!telefone) return null;
  if (deviceToken) {
    const a = buscarAcessoPorToken(telefone, deviceToken);
    if (a && a.status !== 'Bloqueado') return a;
  }
  return null;
}

function apiAtualizarStatus(payload) {
  try {
    const { id, telefone, acao, observacao, deviceToken } = payload;
    if (!id || !acao) return { ok: false, error: 'Parâmetros inválidos' };

    const acesso = resolverAcesso(telefone, deviceToken);
    const modoAdmin = acesso && acesso.tipoAcesso === 'Admin';
    const veioDoAdmin = !deviceToken || modoAdmin;

    const sh = getSheet(SHEET_IMOVEIS);
    const last = sh.getLastRow();
    if (last < 2) return { ok: false, error: 'Sem imóveis' };

    const dados = sh.getRange(2, 1, last - 1, 10).getValues();
    let row = -1, telIm = '', titulo = '', codigo = '';
    for (let i = 0; i < dados.length; i++) {
      if (String(dados[i][0]) === String(id)) {
        row = i + 2;
        telIm = dados[i][1]; titulo = dados[i][2]; codigo = dados[i][9];
        break;
      }
    }
    if (row < 0) return { ok: false, error: 'Imóvel não encontrado' };

    sh.getRange(row, 7).setValue(acao);
    if (observacao !== undefined && observacao !== null) {
      sh.getRange(row, 8).setValue(observacao);
    }
    if (acao === 'gostei') sh.getRange(row, 14).setValue('');
    if (acao === 'quero-visitar') sh.getRange(row, 15).setValue('');

    registrarHistoricoImovel_(id, acao,
      acesso ? normalizaTel(telIm) : normalizaTel(telefone),

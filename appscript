/* =====================================================
   CLONAR VITRINE (V12) — ATUALIZADA
   ✅ Aceita ID (UUID) OU Código no campo imovelIds
   ✅ Usa LockService para evitar colisões em clonagens
      em lote (várias chamadas em sequência do frontend)
   ✅ Compatível com o fluxo antigo (1 imóvel por vez)
===================================================== */
function apiClonarImoveisVitrine(payload) {
  const lock = LockService.getScriptLock();
  try {
    // ✅ Espera até 60s para conseguir o lock (evita colisão
    //    quando o frontend clona vários em sequência)
    if (!lock.tryLock(60000)) {
      return { ok: false, error: 'Sistema ocupado. Tente novamente em instantes.' };
    }

    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }

    const telOrigem  = normalizaTel(payload.telefoneOrigem);
    const telDestino = normalizaTel(payload.telefoneDestino);
    const ids = String(payload.imovelIds || '')
      .split(',')
      .map(s => s.trim())
      .filter(Boolean);

    if (!telOrigem)  return { ok: false, error: 'Telefone de origem vazio' };
    if (!telDestino) return { ok: false, error: 'Telefone de destino vazio' };
    if (telOrigem === telDestino) return { ok: false, error: 'Origem e destino são o mesmo cliente' };
    if (ids.length === 0) return { ok: false, error: 'Nenhum imóvel selecionado' };

    const shCli = getSheet(SHEET_CLIENTES);
    const lastCli = shCli.getLastRow();
    if (lastCli < 2) return { ok: false, error: 'Sem clientes cadastrados' };
    const clientes = shCli.getRange(2, 1, lastCli - 1, 2).getValues();
    let destinoExiste = false, destinoNome = '';
    for (let i = 0; i < clientes.length; i++) {
      if (normalizaTel(clientes[i][0]) === telDestino) {
        destinoExiste = true;
        destinoNome = String(clientes[i][1] || '');
        break;
      }
    }
    if (!destinoExiste) return { ok: false, error: 'Cliente de destino não cadastrado.' };

    const shIm = getSheet(SHEET_IMOVEIS);
    const lastIm = shIm.getLastRow();
    if (lastIm < 2) return { ok: false, error: 'Sem imóveis cadastrados' };

    const dados = shIm.getRange(2, 1, lastIm - 1, 26).getValues();

    // ✅ AQUI ESTÁ A MUDANÇA PRINCIPAL:
    //    Aceita bater por ID (row[0]) OU por Código (row[9]).
    //    Assim, o frontend pode mandar tanto o UUID quanto o
    //    código do imóvel — os dois funcionam.
    const paraClonar = [];
    dados.forEach(row => {
      if (!row[0]) return;
      if (normalizaTel(row[1]) !== telOrigem) return;

      const idDaLinha    = String(row[0] || '').trim();
      const codigoDaLinha = String(row[9] || '').trim();

      const bateuId  = ids.indexOf(idDaLinha) !== -1;
      const bateuCod = codigoDaLinha && ids.indexOf(codigoDaLinha) !== -1;

      if (!bateuId && !bateuCod) return;

      if (String(row[16] || '').toLowerCase() === 'sim') return; // desativado
      paraClonar.push(row);
    });

    if (paraClonar.length === 0) {
      return { ok: false, error: 'Nenhum imóvel válido para clonar' };
    }

    const agora = new Date();
    const novasLinhas = [];
    paraClonar.forEach(row => {
      const novaLinha = row.slice();
      novaLinha[0]  = Utilities.getUuid();
      novaLinha[1]  = telDestino;
      novaLinha[6]  = 'pendente';
      novaLinha[7]  = '';
      novaLinha[8]  = agora;
      novaLinha[10] = '';
      novaLinha[11] = '';
      novaLinha[12] = 'Não';
      novaLinha[13] = '';
      novaLinha[14] = '';
      novaLinha[15] = '';
      novaLinha[16] = '';
      novaLinha[17] = agora;
      novaLinha[25] = '';
      novasLinhas.push(novaLinha);
    });

    const primeiraLinha = shIm.getLastRow() + 1;
    shIm.getRange(primeiraLinha, 1, novasLinhas.length, 26).setValues(novasLinhas);

    registrarHistoricoCliente_(telDestino, 'admin',
      'recebeu ' + novasLinhas.length + ' imóvel(is) por clonagem',
      'origem: ' + telOrigem, 'admin');
    atualizarDataAcao_(telDestino, 'admin');

    return { ok: true, copiados: novasLinhas.length, destino: destinoNome };
  } catch (err) {
    return { ok: false, error: err.message };
  } finally {
    // ✅ SEMPRE libera o lock, mesmo em caso de erro
    try { lock.releaseLock(); } catch (e) {}
  }
}


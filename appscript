    const last = sh.getLastRow();
    if (last < 2) return { ok: false, error: 'Sem clientes' };

    const data = sh.getRange(2, 1, last - 1, 1).getValues();
    for (let i = 0; i < data.length; i++) {
      if (normalizaTel(data[i][0]) === tel) {
        const row = i + 2;
        if (valor === 'automatico') {
          sh.getRange(row, 13).setValue('');
          sh.getRange(row, 14).setValue('');

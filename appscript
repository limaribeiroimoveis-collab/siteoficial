function apiListarCaptacoesQPrecoV3(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }

    const sh = getSheet(SHEET_CAPTACOES);
    const last = sh.getLastRow();
    if (last < 2) return { ok: true, data: [], total: 0 };

    const lastCol = sh.getLastColumn();
    const headers = sh.getRange(1, 1, 1, lastCol).getValues()[0].map(h => String(h || '').trim());
    const idx = {};
    headers.forEach((h, i) => { idx[h] = i; });

    function pega(row, editado, original) {
      if (editado && idx[editado] !== undefined) {
        const v = String(row[idx[editado]] || '').trim();
        if (v) return v;
      }
      if (original && idx[original] !== undefined) {
        return String(row[idx[original]] || '').trim();
      }

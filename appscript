/* =====================================================
   ✅ V16 — API PÚBLICA: SALVAR CAPTAÇÃO QPREÇO
   Rota PÚBLICA (sem senha), chamada pelo site.
   Retorna { ok: true } para liberar a calculadora.
===================================================== */
function apiSalvarCaptacaoQPreco(payload) {
  try {
    const nome        = String(payload.nome || '').trim();
    const telefone    = normalizaTel(payload.telefone);
    const rua         = String(payload.rua || '').trim();
    const numero      = String(payload.numero || '').trim();
    const complemento = String(payload.complemento || '').trim();
    const bairro      = String(payload.bairro || '').trim();

    // Validações
    if (!nome || nome.length < 2) {
      return { ok: false, error: 'Informe seu nome completo.' };
    }
    if (!telefone || telefone.length < 10) {
      return { ok: false, error: 'Informe um telefone válido com DDD.' };
    }
    if (!rua || rua.length < 3) {
      return { ok: false, error: 'Informe o endereço do imóvel.' };
    }
    if (!numero) {
      return { ok: false, error: 'Informe o número do imóvel.' };
    }
    if (!complemento) {
      return { ok: false, error: 'Informe o complemento (ex: Apto 101, Casa, Bloco B...).' };
    }
    if (!bairro || bairro.length < 2) {
      return { ok: false, error: 'Informe o bairro.' };
    }

    const sh = getSheet(SHEET_CAPTACOES);
    const id = Utilities.getUuid();
    const agora = new Date();

    sh.appendRow([
      id,
      agora,
      nome,
      telefone,
      rua,
      numero,
      complemento,
      bairro,
      String(payload.origem || 'qpreco').trim(),
      String(payload.navegador || '').trim(),
      String(payload.ip || '').trim()
    ]);

    // Opcional: registra no histórico do cliente, se ele já existir
    try {
      const shCli = getSheet(SHEET_CLIENTES);
      const lastCli = shCli.getLastRow();
      if (lastCli >= 2) {
        const telefones = shCli.getRange(2, 1, lastCli - 1, 1).getValues();
        for (let i = 0; i < telefones.length; i++) {
          if (normalizaTel(telefones[i][0]) === telefone) {
            registrarHistoricoCliente_(
              telefone,
              'cliente',
              'preencheu QPreço',
              rua + ', ' + numero + ' - ' + complemento + ' - ' + bairro,
              'site'
            );
            atualizarDataAcao_(telefone, 'cliente');
            break;
          }
        }
      }
    } catch (e) {
      Logger.log('Aviso ao registrar histórico (QPreço): ' + e.message);
    }

    return { ok: true, id: id };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}


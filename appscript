        observacoes:  idx['Observacoes'] !== undefined ? String(row[idx['Observacoes']] || '') : '',
        contatoFeito: idx['ContatoFeito'] !== undefined ? String(row[idx['ContatoFeito']] || '') : '',
        atendidoPor:  idx['AtendidoPor'] !== undefined ? String(row[idx['AtendidoPor']] || '') : '',
        
        // Fase 1
        proprietario: idx['Proprietario'] !== undefined ? String(row[idx['Proprietario']] || '') : '',
        cidade:       idx['Cidade']       !== undefined ? String(row[idx['Cidade']] || '') : '',
        anunciadoQA:  idx['AnunciadoQA']  !== undefined ? String(row[idx['AnunciadoQA']] || '') : '',
        intencao:     idx['Intencao']     !== undefined ? String(row[idx['Intencao']] || '') : '',
        
        // Fase 2 (Novos)
        tipo:         pega(row, 'TipoImovel', 'TipoEditado'),
        tipoApto:     pega(row, 'TipoApto', null),
        tipoVaga:     pega(row, 'TipoVaga', null),
        pets:         pega(row, 'Pets', null),
        area:         pega(row, 'AreaEditada', null),
        valorEstimado:pega(row, 'ValorEditado', null),
        quartos:      idx['Quartos'] !== undefined ? String(row[idx['Quartos']] || '') : '',
        suites:       idx['Suites'] !== undefined ? String(row[idx['Suites']] || '') : '',
        banheiros:    idx['Banheiros'] !== undefined ? String(row[idx['Banheiros']] || '') : '',

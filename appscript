function apiListarAgendamentos(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }

    const shI = getSheet(SHEET_IMOVEIS);
    const lastI = shI.getLastRow();
    if (lastI < 2) return { ok: true, data: [] };

    const dataI = shI.getRange(2, 1, lastI - 1, 26).getValues();
    const agendados = [];
    for (let i = 0; i < dataI.length; i++) {
      const row = dataI[i];
      if (!row[0]) continue;
      if (!row[15]) continue;
      if (String(row[16] || '').toLowerCase() === 'sim') continue;
      agendados.push({
        id: String(row[0]), telefone: String(row[1] || ''),
        titulo: String(row[2] || ''), link: String(row[4] || ''),
        imagem: String(row[5] || ''), codigo: String(row[9] || ''),
        dataVisitaAgendada: toISO(row[15]),
        chaveTexto: String(row[18] || ''),
        rua: String(row[19] || ''), numero: String(row[20] || ''),
        bairro: String(row[21] || '')
      });
    }

    const shC = getSheet(SHEET_CLIENTES);
    const lastC = shC.getLastRow();
    const clientesMap = {};
    if (lastC >= 2) {
      const dataC = shC.getRange(2, 1, lastC - 1, 12).getValues();
      for (let i = 0; i < dataC.length; i++) {
        const tel = normalizaTel(dataC[i][0]);
        if (!tel) continue;
        clientesMap[tel] = {
          nome: String(dataC[i][1] || ''),
          corretor: String(dataC[i][2] || '')
        };
      }
    }

    const out = agendados.map(a => {
      const cli = clientesMap[normalizaTel(a.telefone)] || {};
      return {
        ...a,
        clienteNome: cli.nome || '(sem cadastro)',
        corretor: cli.corretor || '(sem corretor)'
      };
    });
    out.sort((a, b) => new Date(a.dataVisitaAgendada) - new Date(b.dataVisitaAgendada));
    return { ok: true, data: out };
  } catch (err) { return { ok: false, error: err.message }; }
}


            id: String(a[0]), apelido: apelido, senha: String(a[3] || '')
          };
        } else {
          if (!acessoCliente) acessoCliente = {
            id: String(a[0]), apelido: apelido, senha: String(a[3] || '')
          };
        }
      }
    }

    // Cria acesso Cliente se não existir
    if (!acessoCliente) {
      const novo = criarAcessoAutomatico_(tel, nomeCli);
      acessoCliente = { id: novo.id, apelido: novo.apelido, senha: novo.senha };
    }

    // Cria acesso Admin de X se não existir
    if (!acessoAdmin) {
      const apelidoAdmin = 'Admin de ' + primeiroNome(nomeCli);
      let senha = gerarSenha();
      let t = 0;
      while (senhaJaExiste(senha) && t < 20) { senha = gerarSenha(); t++; }
      const idA = Utilities.getUuid();
      shAce.appendRow([idA, tel, apelidoAdmin, senha, '', '', 'Ativo', new Date(), '', 'Admin']);
      acessoAdmin = { id: idA, apelido: apelidoAdmin, senha: senha };
      registrarHistoricoCliente_(tel, 'admin', 'criou acesso admin',
        'apelido: ' + apelidoAdmin, 'admin');
    }

    const linkCliente = DOMINIO_VITRINE + '?tel=' + tel + '&senha=' + acessoCliente.senha;
    const linkAdmin   = DOMINIO_VITRINE + '?tel=' + tel + '&senha=' + acessoAdmin.senha;

    // Salva o link do CLIENTE na coluna LinkVitrine
    if (lastCli >= 2) {
      const telefones = shCli.getRange(2, 1, lastCli - 1, 1).getValues();
      for (let i = 0; i < telefones.length; i++) {
        if (normalizaTel(telefones[i][0]) === tel) {
          shCli.getRange(i + 2, 8).setValue(linkCliente);
          break;
        }
      }
    }

    return {
      ok: true,
      nome: nomeCli,
      cliente: {
        apelido: acessoCliente.apelido,
        senha: acessoCliente.senha,
        link: linkCliente
      },
      admin: {
        apelido: acessoAdmin.apelido,
        senha: acessoAdmin.senha,
        link: linkAdmin
      }
    };
  } catch (err) { return { ok: false, error: err.message }; }
}


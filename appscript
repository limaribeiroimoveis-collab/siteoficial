/* =====================================================
   ✅ FUNÇÃO AUXILIAR — EXTRAI Nº DO APTO DO chaveTexto
   Usada pela vitrine pública para exibir o andar.
   Extrai apenas o NÚMERO (não expõe o resto do chaveTexto).
===================================================== */
function extrairNumeroAptoDoChave_(chaveTexto) {
  if (!chaveTexto) return '';
  var primeiraLinha = String(chaveTexto).split(/\r?\n/)[0] || '';
  // Procura "apt 402", "apto 402", "ap 402", "• 402", ou só "402"
  var m = primeiraLinha.match(/(?:apto?|ap|apartamento)?\s*[•·:]?\s*(\d{1,6})/i);
  return m ? m[1] : '';
}


  // ─────────────────────────────────────────────

  // Versão ANTIGA (a que está no código atual)
  function isSimAntiga(valor) {
    return String(valor || '').toLowerCase() === 'sim';
  }

  // Versão NOVA (robusta, aceita variações)
  function isSimNova(valor) {
    if (valor === true) return true;
    if (valor === false || valor === null || valor === undefined) return false;
    const s = String(valor).trim().toLowerCase();
    if (!s) return false;
    return s === 'sim' || s === 's' || s === 'yes' || s === 'y' ||
           s === 'true' || s === 't' || s === '1' || s === 'x' ||
           s === 'vendido' || s === 'v';
  }

  // ─────────────────────────────────────────────
  // Contadores
  // ─────────────────────────────────────────────
  let total = 0;
  let totalVendidos = 0;      // Considerando "Sim" como referência "oficial"
  let detectadosAntiga = 0;   // Quantos a versão ANTIGA reconhece
  let detectadosNova = 0;     // Quantos a versão NOVA reconhece
  let naoDetectadosAntiga = 0;
  let naoDetectadosNova = 0;

  // Agrupamento por variante exata do valor cru
  const variantes = {};

  // Lista de "casos estranhos" (não vazios, não "Sim" perfeito)
  const casosEstranhos = [];

  // Lista de "vendidos que a versão antiga perdeu"
  const perdidosAntiga = [];

  // ─────────────────────────────────────────────
  // Varredura
  // ─────────────────────────────────────────────
  for (let i = 0; i < dados.length; i++) {
    const row = dados[i];
    if (!row[0]) continue; // linha sem ID

    total++;

    const codigo = String(row[9] || '').trim();
    const vendidoRaw = row[25];
    const vendidoStr = String(
      vendidoRaw === null || vendidoRaw === undefined ? '' : vendidoRaw
    );
    const vendidoTrim = vendidoStr.trim();
    const vendidoLower = vendidoTrim.toLowerCase();

    // Conta como "vendido oficial" tudo que é sim/true/1 (versão nova)
    const vendidoOficial = isSimNova(vendidoRaw);
    const vendidoAntiga  = isSimAntiga(vendidoRaw);

    if (vendidoOficial) totalVendidos++;
    if (vendidoAntiga) detectadosAntiga++;
    if (vendidoOficial) detectadosNova++;

    // Casos em que a versão nova identifica mas a antiga NÃO
    if (vendidoOficial && !vendidoAntiga) {
      naoDetectadosAntiga++;
      perdidosAntiga.push({
        linha: i + 2,
        codigo: codigo,
        valorCru: vendidoRaw,
        valorStr: vendidoStr,
        tipo: typeof vendidoRaw,
        tamanho: vendidoStr.length
      });
    }

    // Variantes para relatório (só se tiver algo preenchido)
    if (vendidoTrim) {
      const chave = '[' + typeof vendidoRaw + '] ' + JSON.stringify(vendidoStr);
      if (!variantes[chave]) {
        variantes[chave] = { qtd: 0, exemplos: [] };
      }
      variantes[chave].qtd++;
      if (variantes[chave].exemplos.length < 3) {
        variantes[chave].exemplos.push('linha ' + (i + 2) + ' (#' + codigo + ')');
      }

      // Casos estranhos (não vazio, não "sim" perfeito)
      if (vendidoLower !== 'sim') {
        casosEstranhos.push({
          linha: i + 2,
          codigo: codigo,
          valorCru: vendidoRaw,
          valorStr: vendidoStr,
          tipo: typeof vendidoRaw,
          tamanho: vendidoStr.length,
          temEspaco: vendidoStr !== vendidoTrim,
          isSimNova: isSimNova(vendidoRaw)
        });
      }
    }
  }

  // ─────────────────────────────────────────────
  // Monta o relatório
  // ─────────────────────────────────────────────
  log.push('═══════════════════════════════════════════════');
  log.push('🔍 TESTE DE DETECÇÃO DE VENDIDOS');
  log.push('═══════════════════════════════════════════════');
  log.push('');

  log.push('📊 TOTAIS:');
  log.push('   Total de imóveis na planilha: ' + total);
  log.push('   Marcados como vendidos:       ' + totalVendidos);
  log.push('');

  log.push('🔬 COMPARAÇÃO DAS VERSÕES:');
  log.push('   Versão ANTIGA (só "sim" exato) → detecta ' + detectadosAntiga + ' de ' + totalVendidos);
  log.push('   Versão NOVA  (robusta)          → detecta ' + detectadosNova + ' de ' + totalVendidos);
  log.push('');

  if (naoDetectadosAntiga === 0) {
    log.push('✅ A versão ANTIGA já detecta TODOS os vendidos.');
    log.push('   → Nenhuma correção é necessária no backend.');
    log.push('   → Se ainda assim o HTML mostra errado, o problema está no HTML.');
  } else {
    log.push('❌ A versão ANTIGA está PERDENDO ' + naoDetectadosAntiga + ' imóvel(is) vendido(s).');
    log.push('   → A versão NOVA corrige isso. Substitua o backend pela versão robusta.');
    log.push('');
    log.push('📋 Vendidos que a versão ANTIGA não reconhece:');
    perdidosAntiga.slice(0, 30).forEach(p => {
      log.push('   Linha ' + p.linha + ' | #' + p.codigo + ' | valor=' + JSON.stringify(p.valorStr) +
               ' | tipo=' + p.tipo + ' | tamanho=' + p.tamanho);
    });
    if (perdidosAntiga.length > 30) {
      log.push('   ... e mais ' + (perdidosAntiga.length - 30) + ' (total ' + naoDetectadosAntiga + ')');
    }
  }

  log.push('');
  log.push('═══════════════════════════════════════════════');
  log.push('🔬 VARIANTES ENCONTRADAS NA COLUNA VENDIDO:');
  log.push('═══════════════════════════════════════════════');
  Object.keys(variantes).forEach(chave => {
    const v = variantes[chave];
    log.push('');
    log.push('• ' + chave);
    log.push('  Quantidade: ' + v.qtd + 'x');
    log.push('  Exemplos: ' + v.exemplos.join(', '));
  });

  log.push('');
  log.push('═══════════════════════════════════════════════');
  log.push('⚠️ CASOS ESTRANHOS (não vazios, não "sim" perfeito):');
  log.push('═══════════════════════════════════════════════');
  if (casosEstranhos.length === 0) {
    log.push('✅ Nenhum caso estranho. Todos os valores são "sim" exato ou vazio.');
  } else {
    log.push('Total de casos estranhos: ' + casosEstranhos.length);
    log.push('');
    casosEstranhos.slice(0, 30).forEach(c => {
      log.push('  Linha ' + c.linha + ' | #' + c.codigo);
      log.push('    valor cru: ' + JSON.stringify(c.valorStr));
      log.push('    tipo: ' + c.tipo + ' | tamanho: ' + c.tamanho +
               (c.temEspaco ? ' | ⚠️ TEM ESPAÇO' : ''));
      log.push('    versão nova reconhece? ' + (c.isSimNova ? '✅ SIM' : '❌ NÃO'));
    });
    if (casosEstranhos.length > 30) {
      log.push('  ... e mais ' + (casosEstranhos.length - 30) + ' (total ' + casosEstranhos.length + ')');
    }
  }

  log.push('');
  log.push('═══════════════════════════════════════════════');
  log.push('🎯 CONCLUSÃO');
  log.push('═══════════════════════════════════════════════');

  if (totalVendidos === 0) {
    log.push('⚠️ NÃO há nenhum imóvel marcado como vendido na planilha!');
    log.push('   → Verifique manualmente a coluna 26 (Vendido).');
  } else if (detectadosAntiga === totalVendidos) {
    log.push('✅ Backend atual está CORRETO.');
    log.push('   → Corrija apenas o HTML (função isVendido).');
  } else if (detectadosNova === totalVendidos) {
    log.push('✅ A versão NOVA detecta TODOS os ' + totalVendidos + ' vendidos.');
    log.push('   → Substitua apiListarImoveisPublicos e montaImovelObj_ pela versão robusta.');
    log.push('   → Depois corrija o HTML (função isVendido).');
  } else {
    log.push('⚠️ NEM a versão nova detecta tudo.');
    log.push('   → Existem formatos exóticos na planilha. Envie este log para análise.');
  }

  const msg = log.join('\n');
  Logger.log(msg);
  return msg;
}

/* =====================================================
   🔍 DIAGNÓSTICO COMPLETO — IMÓVEIS NA PLANILHA vs API
   
   Compara linha a linha:
   - Quantos imóveis existem na planilha
   - Quantos a API pública está retornando
   - Quantos são filtrados por cada regra (desativado, sem código, etc)
   - Quantos marcados como Vendido = "Sim"
   - Lista os códigos que estão na planilha mas NÃO estão na API
   
   100% LEITURA. Nada é alterado.
===================================================== */
function DIAGNOSTICO_FALTANDO_IMOVEIS() {
  const sh = getSheet(SHEET_IMOVEIS);
  const last = sh.getLastRow();
  if (last < 2) { Logger.log('Sem dados'); return; }

  const dados = sh.getRange(2, 1, last - 1, 27).getValues();
  const log = [];
  log.push('═══════════════════════════════════════════════');
  log.push('🔍 DIAGNÓSTICO — IMÓVEIS NA PLANILHA vs API');
  log.push('═══════════════════════════════════════════════');
  log.push('');

  // ─── Contadores ───
  let totalLinhas = 0;
  let semId = 0;
  let semCodigo = 0;
  let desativados = 0;
  let vendidos = 0;
  let comCodigoEDesativadoFalseEVendidoFalse = 0;

  // Por CÓDIGO único (para comparar com a API, que agrupa)
  const codigosValidos = new Set();      // códigos que deveriam aparecer na API
  const codigosPorMotivo = {
    semCodigo: [],
    desativado: [],
    vendido: []
  };

  // Por código, guarda todos os motivos (um código pode ter várias linhas em clientes diferentes)
  const infoPorCodigo = {};

  for (let i = 0; i < dados.length; i++) {
    const row = dados[i];
    if (!row[0]) continue; // linha sem ID, ignora
    totalLinhas++;

    const id = String(row[0] || '').trim();
    const codigo = String(row[9] || '').trim();
    const desativado = String(row[16] || '').trim().toLowerCase() === 'sim';
    const vendido    = String(row[25] || '').trim().toLowerCase() === 'sim';

    if (!id) { semId++; continue; }
    if (!codigo) { semCodigo++; if (codigosPorMotivo.semCodigo.length < 50) codigosPorMotivo.semCodigo.push('linha ' + (i+2) + ' (id ' + id.substring(0,8) + ')'); continue; }

    if (!infoPorCodigo[codigo]) {
      infoPorCodigo[codigo] = {
        codigo,
        linhasTotais: 0,
        linhasValidas: 0,
        temDesativado: false,
        temVendido: false,
        titulo: String(row[2] || '')
      };
    }
    infoPorCodigo[codigo].linhasTotais++;

    if (desativado) {
      infoPorCodigo[codigo].temDesativado = true;
      desativados++;
    }
    if (vendido) {
      infoPorCodigo[codigo].temVendido = true;
      vendidos++;
    }
    if (!desativado && !vendido) {
      infoPorCodigo[codigo].linhasValidas++;
      comCodigoEDesativadoFalseEVendidoFalse++;
      codigosValidos.add(codigo);
    }
  }

  // ─── Compara com a API ───
  const apiRes = apiListarImoveisPublicos({});
  const codigosNaAPI = new Set((apiRes.data || []).map(im => String(im.codigo || '').trim()));

  // Códigos que existem na planilha (com pelo menos 1 linha válida) mas NÃO na API
  const faltandoNaAPI = [];
  codigosValidos.forEach(cod => {
    if (!codigosNaAPI.has(cod)) {
      const info = infoPorCodigo[cod];
      faltandoNaAPI.push({
        codigo: cod,
        titulo: info.titulo,
        linhasTotais: info.linhasTotais,
        linhasValidas: info.linhasValidas,
        temDesativado: info.temDesativado,
        temVendido: info.temVendido
      });
    }
  });

  // ─── MONTAGEM DO LOG ───
  log.push('📊 PLANILHA:');
  log.push('   Linhas com ID (total): ' + totalLinhas);
  log.push('   Linhas SEM código: ' + semCodigo);
  log.push('   Linhas DESATIVADAS: ' + desativados);
  log.push('   Linhas marcadas VENDIDO: ' + vendidos);
  log.push('   Linhas válidas (não desativadas, não vendidas): ' + comCodigoEDesativadoFalseEVendidoFalse);
  log.push('');
  log.push('   Códigos ÚNICOS válidos na planilha: ' + codigosValidos.size);
  log.push('   Códigos únicos retornados pela API: ' + codigosNaAPI.size);
  log.push('');

  // ─── VENDIDOS NA PLANILHA (cru) ───
  log.push('═══════════════════════════════════════════════');
  log.push('🏷️ VENDIDOS NA PLANILHA (Vendido = "Sim")');
  log.push('═══════════════════════════════════════════════');
  log.push('Total de linhas com Vendido = "Sim": ' + vendidos);
  log.push('');
  log.push('Listando TODOS os códigos marcados como vendidos:');
  let contVend = 0;
  Object.keys(infoPorCodigo).forEach(cod => {
    if (infoPorCodigo[cod].temVendido) {
      contVend++;
      log.push('   #' + cod + ' — ' + infoPorCodigo[cod].titulo.substring(0, 50));
    }
  });
  log.push('   (Total de códigos únicos com vendido: ' + contVend + ')');
  log.push('');

  // ─── FALTANDO NA API ───
  log.push('═══════════════════════════════════════════════');
  log.push('⚠️ CÓDIGOS VÁLIDOS QUE NÃO VIERAM NA API:');
  log.push('═══════════════════════════════════════════════');
  if (faltandoNaAPI.length === 0) {
    log.push('✅ Nenhum — API está retornando todos os códigos válidos da planilha.');
  } else {
    log.push('Total faltando: ' + faltandoNaAPI.length);
    faltandoNaAPI.slice(0, 50).forEach(f => {
      log.push('   #' + f.codigo + ' — ' + f.titulo.substring(0, 50));
      log.push('      Linhas totais: ' + f.linhasTotais + ' | Linhas válidas: ' + f.linhasValidas +
               ' | Tem desativado: ' + f.temDesativado + ' | Tem vendido: ' + f.temVendido);
    });
    if (faltandoNaAPI.length > 50) {
      log.push('   ... e mais ' + (faltandoNaAPI.length - 50));
    }
  }
  log.push('');

  // ─── CÓDIGOS SEM CÓDIGO (não vão pra API) ───
  log.push('═══════════════════════════════════════════════');
  log.push('⚠️ IMÓVEIS SEM CÓDIGO (não vão pra vitrine pública):');
  log.push('═══════════════════════════════════════════════');
  if (codigosPorMotivo.semCodigo.length === 0) {
    log.push('✅ Nenhum — todos os imóveis têm código.');
  } else {
    log.push('Total de linhas sem código: ' + semCodigo);
    log.push('Primeiras 50 linhas (para identificar):');
    codigosPorMotivo.semCodigo.forEach(t => log.push('   ' + t));
    if (semCodigo > 50) log.push('   ... e mais ' + (semCodigo - 50));
  }
  log.push('');

  // ─── CONCLUSÃO ───
  log.push('═══════════════════════════════════════════════');
  log.push('🎯 CONCLUSÃO');
  log.push('═══════════════════════════════════════════════');

  if (faltandoNaAPI.length === 0 && semCodigo === 0) {
    log.push('✅ API está entregando TODOS os imóveis válidos da planilha.');
    log.push('   Se no HTML faltam imóveis, o problema é na renderização do frontend.');
  } else if (faltandoNaAPI.length > 0) {
    log.push('❌ ' + faltandoNaAPI.length + ' código(s) válidos NÃO estão chegando na API.');
    log.push('   Verifique o motivo de cada um na lista acima.');
  } else if (semCodigo > 0) {
    log.push('⚠️ Existem ' + semCodigo + ' linhas SEM código.');
    log.push('   Imóveis sem código não vão para a vitrine pública.');
  }

  log.push('');
  log.push('Sobre os VENDIDOS:');
  log.push('   Planilha tem ' + vendidos + ' linhas com Vendido = "Sim".');
  log.push('   Destes, ' + contVend + ' são códigos únicos.');
  log.push('   A API pública NÃO retorna vendidos (eles são filtrados).');
  log.push('   No HTML, o contador "Ocultar vendidos (N)" deve mostrar: ' + contVend);
  log.push('   (Se está mostrando outro número, o problema está no HTML/frontend.)');

  const msg = log.join('\n');
  Logger.log(msg);
  return msg;
}

/* ============================================
   4) ATUALIZAR LEAD VIP — rota ADMIN
   Atualiza status, corretor, observações,
   nome, telefone, bairros, detalhes.
   Regra: 'cadastrado' e 'vitrine' exigem corretor.
============================================ */
function apiAtualizarLeadVIP(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }
    const id = String(payload.id || '').trim();
    if (!id) return { ok: false, error: 'ID vazio' };

    const sh = getSheet(SHEET_LEADS_VIP);
    const last = sh.getLastRow();
    if (last < 2) return { ok: false, error: 'Sem leads' };

    const lastCol = sh.getLastColumn();
    const headers = sh.getRange(1, 1, 1, lastCol).getValues()[0]
      .map(h => String(h || '').trim());
    const col = {};
    headers.forEach((h, i) => { col[h] = i + 1; }); // 1-based

    // Acha a linha
    const ids = sh.getRange(2, 1, last - 1, 1).getValues();
    let linha = -1;
    for (let i = 0; i < ids.length; i++) {
      if (String(ids[i][0]) === id) { linha = i + 2; break; }
    }
    if (linha < 0) return { ok: false, error: 'Lead não encontrado' };

    // Lê estado atual para validar transições
    const linhaAtual = sh.getRange(linha, 1, 1, lastCol).getValues()[0];
    const valorAtual = (nomeCol) => col[nomeCol]
      ? String(linhaAtual[col[nomeCol] - 1] || '').trim()
      : '';
    const statusAtual   = valorAtual('Status');
    const atendidoAtual = valorAtual('AtendidoPor');

    // ───── Status ─────
    if (payload.status !== undefined) {
      const novoStatus = String(payload.status || '').trim();
      const statusValidos = ['', 'cadastrado', 'vitrine', 'nao-atendemos'];
      if (statusValidos.indexOf(novoStatus) === -1) {
        return { ok: false, error: 'Status inválido: ' + novoStatus };
      }

      // Regra: 'cadastrado' e 'vitrine' exigem corretor
      if (novoStatus === 'cadastrado' || novoStatus === 'vitrine') {
        const corretorQueVaiFicar = (payload.atendidoPor !== undefined)
          ? String(payload.atendidoPor || '').trim()
          : atendidoAtual;
        if (!corretorQueVaiFicar) {
          return { ok: false, error: 'Atribua um corretor antes de marcar como "' + novoStatus + '".' };
        }
      }

      sh.getRange(linha, col['Status']).setValue(novoStatus);
    }

    // ───── Corretor ─────
    if (payload.atendidoPor !== undefined) {
      const novoCorretor = String(payload.atendidoPor || '').trim();

      // Se está tirando o corretor mas status atual exige, bloqueia
      if (!novoCorretor) {
        const statusDepois = (payload.status !== undefined)
          ? String(payload.status || '').trim()
          : statusAtual;
        if (statusDepois === 'cadastrado' || statusDepois === 'vitrine') {
          return { ok: false, error: 'Não é possível remover o corretor com status "' + statusDepois + '".' };
        }
      }
      sh.getRange(linha, col['AtendidoPor']).setValue(novoCorretor);
    }

    // ───── Observações ─────
    if (payload.observacoes !== undefined) {
      sh.getRange(linha, col['Observacoes']).setValue(String(payload.observacoes || ''));
    }

    // ───── Edição de dados ─────
    if (payload.nome !== undefined && col['Nome']) {
      sh.getRange(linha, col['Nome']).setValue(String(payload.nome || '').trim());
    }
    if (payload.telefone !== undefined && col['Telefone']) {
      sh.getRange(linha, col['Telefone']).setValue(normalizaTel(payload.telefone));
    }
    if (payload.bairros !== undefined && col['Bairros']) {
      sh.getRange(linha, col['Bairros']).setValue(String(payload.bairros || '').trim());
    }
    if (payload.detalhes !== undefined && col['Detalhes']) {
      sh.getRange(linha, col['Detalhes']).setValue(String(payload.detalhes || '').trim());
    }

    // ───── Data de atualização ─────
    if (col['DataAtualizacao']) {
      sh.getRange(linha, col['DataAtualizacao']).setValue(new Date());
    }

    return { ok: true, id: id };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}


/* ============================================
   2) SALVAR LEAD VIP — rota PÚBLICA
   Chamada pelo selecaovip.html quando o cliente
   preenche o formulário.
============================================ */
function apiSalvarLeadVIP(payload) {
  try {
    const nome        = String(payload.nome || '').trim();
    const telefone    = normalizaTel(payload.telefone);
    const tipo        = String(payload.tipo || '').trim();
    const tipoApto    = String(payload.tipoApto || '').trim(); // "Padrão, Cobertura, Área Privativa"
    const cidades     = String(payload.cidades || '').trim();  // "BH, Contagem, Nova Lima"
    const quartos     = String(payload.quartos || '').trim();
    const banheiros   = String(payload.banheiros || '').trim();
    const suites      = String(payload.suites || '').trim();
    const vagas       = String(payload.vagas || '').trim();
    const detalhes    = String(payload.detalhes || '').trim();
    const navegador   = String(payload.navegador || '').trim();

    let metragemMin = String(payload.metragemMin || '').trim();
    let metragemMax = String(payload.metragemMax || '').trim();
    let valorMin    = String(payload.valorMin || '').trim();
    let valorMax    = String(payload.valorMax || '').trim();

    if (!metragemMin && payload.metragem) metragemMin = String(payload.metragem || '').trim();
    if (!valorMax && payload.valor) valorMax = String(payload.valor || '').trim();

    if (metragemMin === 'tanto-faz' || metragemMin === 'nao-informado') metragemMin = '';
    if (metragemMax === 'tanto-faz' || metragemMax === 'nao-informado') metragemMax = '';
    if (valorMin === 'tanto-faz' || valorMin === 'nao-informado') valorMin = '';
    if (valorMax === 'tanto-faz' || valorMax === 'nao-informado') valorMax = '';

    if (valorMin) valorMin = valorMin.replace(/\D/g, '');
    if (valorMax) valorMax = valorMax.replace(/\D/g, '');
    if (metragemMin) metragemMin = metragemMin.replace(/\D/g, '');
    if (metragemMax) metragemMax = metragemMax.replace(/\D/g, '');

    if (!nome || nome.length < 2) return { ok: false, error: 'Informe seu nome completo.' };
    if (!telefone || telefone.length < 10) return { ok: false, error: 'Informe um telefone válido com DDD.' };
    if (!tipo) return { ok: false, error: 'Escolha o tipo de imóvel.' };

    const sh = getSheet(SHEET_LEADS_VIP);
    const id = Utilities.getUuid();
    const agora = new Date();

    const quartosFinal    = (quartos    === 'tanto-faz') ? '' : quartos;
    const banheirosFinal  = (banheiros  === 'tanto-faz') ? '' : banheiros;
    const suitesFinal     = (suites     === 'tanto-faz') ? '' : suites;
    const vagasFinal      = (vagas      === 'tanto-faz') ? '' : vagas;
    const detalhesFinal   = (detalhes   === 'nenhum')    ? '' : detalhes;

    // O campo Bairros antigo receberá as Cidades e o TipoApto.
    // Como a planilha tem colunas fixas, salvamos assim:
    // Bairros = cidades
    // Detalhes = detalhes originais + tipoApto
    const bairrosFinal = cidades || '';
    
    let detalhesCompleto = detalhesFinal;
    if (tipoApto) {
      detalhesCompleto += (detalhesCompleto ? ' | ' : '') + 'Tipo Apto: ' + tipoApto;
    }

        // Coluna "Bairros" continua guardando as CIDADES (comportamento antigo).
    // Coluna nova "BairrosDigitados" guarda os BAIRROS/REGIÕES que o cliente digitou.
    const bairrosDigitados = String(payload.bairros || '').trim();

    sh.appendRow([
      id,
      agora,
      nome,
      telefone,
      tipo,
      quartosFinal,
      banheirosFinal,
      suitesFinal,
      vagasFinal,
      metragemMin,
      metragemMax,
      valorMin,
      valorMax,
      bairrosFinal,          // coluna 14 — "Bairros" (na prática: cidades)
      detalhesCompleto,      // coluna 15 — "Detalhes"
      '', '', '',            // colunas 16-18 — Status, AtendidoPor, Observacoes
      navegador,             // coluna 19
      agora,                 // coluna 20 — DataAtualizacao
      bairrosDigitados       // coluna 21 — BairrosDigitados (NOVO)
    ]);

    return { ok: true, id: id };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}


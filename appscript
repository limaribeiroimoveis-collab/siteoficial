function apiListarImoveis(payload) {
  try {
    const tel = normalizaTel(payload.telefone);
    const deviceToken = payload.deviceToken || '';
    if (!tel) return { ok: false, error: 'Telefone vazio' };
    if (!deviceToken) return { ok: false, error: 'Sessão inválida.' };

    const acesso = buscarAcessoPorToken(tel, deviceToken);
    if (!acesso) return { ok: false, error: 'Sessão expirada.' };
    if (acesso.status === 'Bloqueado') return { ok: false, error: 'Acesso bloqueado.' };
    atualizarUltimoAcesso(acesso.rowIndex);

    const sh = getSheet(SHEET_IMOVEIS);
    const last = sh.getLastRow();
    if (last < 2) return { ok: true, data: [] };

    const data = sh.getRange(2, 1, last - 1, 26).getValues();
    const out = [];
    for (let i = 0; i < data.length; i++) {
      const row = data[i];
      if (!row[0]) continue;
      if (normalizaTel(row[1]) !== tel) continue;
      if (String(row[16] || '').toLowerCase() === 'sim') continue;
      out.push(montaImovelObj_(row));
    }
    out.sort((a, b) => new Date(b.dataCadastro) - new Date(a.dataCadastro));
    return { ok: true, data: out };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}


/* =====================================================
   UTILITÁRIOS
===================================================== */
function getSS() { return SpreadsheetApp.openById(SPREADSHEET_ID); }

function getSheet(name) {
  const sh = getSS().getSheetByName(name);
  if (!sh) throw new Error('Aba não encontrada: ' + name);
  return sh;
}

function getConfig(key) {
  const sh = getSheet(SHEET_CONFIG);
  const data = sh.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (data[i][0] === key) return String(data[i][1]);
  }
  return null;
}

function normalizaTel(t) { return String(t || '').replace(/\D/g, ''); }

function extrairCodigoImovel(url) {
  if (!url) return '';
  const m = String(url).match(/\/imovel\/v\d+\/(\d+)/);
  return m ? m[1] : '';
}

function toISO(v) {
  if (!v) return '';
  try { return new Date(v).toISOString(); } catch (e) { return ''; }
}

function gerarSenha() {
  const chars = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789';
  let s = '';
  for (let i = 0; i < 6; i++) s += chars.charAt(Math.floor(Math.random() * chars.length));
  return s;
}

function gerarToken() { return Utilities.getUuid() + '-' + Utilities.getUuid(); }

function primeiroNome(nome) {
  return String(nome || '').trim().split(/\s+/)[0] || 'Cliente';
}

function montarTitulo_(rua, numero, bairro) {
  const r = String(rua || '').trim();
  const n = String(numero || '').trim();
  const b = String(bairro || '').trim();
  let t = r;
  if (n) t += (t ? ', ' : '') + n;
  if (b) t += (t ? ' - ' : '') + b;
  return t;
}

/* =====================================================
   TEMPERATURA
===================================================== */
function calcularTemperatura(ultimaVisitaConcluida) {
  if (!ultimaVisitaConcluida) return 'frio';
  const dias = Math.floor((Date.now() - new Date(ultimaVisitaConcluida).getTime()) / 86400000);
  if (dias <= 10) return 'morno';
  return 'frio';
}

function ultimaVisitaConcluidaDoCliente_(telefone) {
  const tel = normalizaTel(telefone);
  if (!tel) return null;
  const sh = getSheet(SHEET_IMOVEIS);
  const last = sh.getLastRow();
  if (last < 2) return null;
  const dados = sh.getRange(2, 1, last - 1, 13).getValues();
  let maior = null;
  dados.forEach(row => {
    if (normalizaTel(row[1]) !== tel) return;
    if (String(row[12] || '').toLowerCase() !== 'sim') return;
    const d = row[10];
    if (!d) return;
    const dt = new Date(d);
    if (isNaN(dt.getTime())) return;
    if (!maior || dt > maior) maior = dt;
  });
  return maior;
}

function temperaturaDoCliente_(telefone, rowCliente) {
  const tel = normalizaTel(telefone);
  let quenteManual = '';
  let temperaturaManual = '';
  if (rowCliente) {
    quenteManual = String(rowCliente[12] || '');
    temperaturaManual = String(rowCliente[13] || '');
  }
  if (String(temperaturaManual).toLowerCase() === 'sim') {
    const v = String(quenteManual || '').toLowerCase();
    if (v === 'quente' || v === 'morno' || v === 'frio') {
      return { temperatura: v, manual: true };
    }
  }
  const ultVisita = ultimaVisitaConcluidaDoCliente_(tel);
  return { temperatura: calcularTemperatura(ultVisita), manual: false };
}


      return { ok: false, error: 'Senha incorreta' };
    }
    const { id, dataAgendada, rua, numero, bairro } = payload;
    if (!id) return { ok: false, error: 'ID vazio' };
    if (!dataAgendada) return { ok: false, error: 'Informe data e hora' };
    if (!String(numero || '').trim()) {
      return { ok: false, error: 'Informe o número do imóvel para agendar' };
    }

    const sh = getSheet(SHEET_IMOVEIS);
    const last = sh.getLastRow();
    if (last < 2) return { ok: false, error: 'Sem imóveis' };

    const dados = sh.getRange(2, 1, last - 1, 26).getValues();
    for (let i = 0; i < dados.length; i++) {
      if (String(dados[i][0]) === String(id)) {
        const row = i + 2;
        const tel = dados[i][1];
        const codigo = dados[i][9];

        const ruaF = String(rua || dados[i][19] || '').trim();
        const numF = String(numero || '').trim();
        const baiF = String(bairro || dados[i][21] || '').trim();
        const tituloFinal = montarTitulo_(ruaF, numF, baiF) || String(dados[i][2] || '');

        const linhaAtual = sh.getRange(row, 1, 1, 26).getValues()[0];
        linhaAtual[2]  = tituloFinal;
        linhaAtual[15] = dataAgendada;
        linhaAtual[17] = new Date();
        linhaAtual[19] = ruaF;
        linhaAtual[20] = numF;
        linhaAtual[21] = baiF;
        sh.getRange(row, 1, 1, 26).setValues([linhaAtual]);

        const detalhe = tituloFinal + (codigo ? ' #' + codigo : '') + ' — ' + dataAgendada;
        registrarHistoricoImovel_(id, 'visita agendada', tel, 'admin');
        if (tel) {
          registrarHistoricoCliente_(tel, 'admin', 'agendou visita', detalhe, 'admin');
          atualizarDataAcao_(tel, 'admin');
        }
        return { ok: true };
      }
    }
    return { ok: false, error: 'Imóvel não encontrado' };
  } catch (err) { return { ok: false, error: err.message }; }
}


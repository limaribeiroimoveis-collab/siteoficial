      .setMimeType(ContentService.MimeType.JSON);
  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({ ok: false, error: 'Erro: ' + err.message }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

/* =====================================================
   LOGIN
===================================================== */
function apiLoginCliente(payload) {
  try {
    const tel = normalizaTel(payload.telefone);
    const senhaInformada = String(payload.senha || '').toUpperCase().trim();
    const deviceToken = payload.deviceToken || '';
    const navegador = payload.navegador || '';
    if (!tel) return { ok: false, error: 'Telefone vazio' };

    const shCli = getSheet(SHEET_CLIENTES);
    let clienteExiste = false, clienteNome = '';
    if (shCli.getLastRow() >= 2) {
      const clientes = shCli.getRange(2, 1, shCli.getLastRow() - 1, 2).getValues();
      for (let i = 0; i < clientes.length; i++) {
        if (normalizaTel(clientes[i][0]) === tel) {
          clienteExiste = true;
          clienteNome = String(clientes[i][1] || '');
          break;
        }
      }
    }
    if (!clienteExiste) {
      return { ok: false, error: 'Telefone não autorizado. Fale com seu corretor.' };
    }

    if (deviceToken) {
      const acesso = buscarAcessoPorToken(tel, deviceToken);
      if (acesso) {
        if (acesso.status === 'Bloqueado') {
          return { ok: false, error: 'Acesso bloqueado. Fale com seu corretor.' };
        }
        atualizarUltimoAcesso(acesso.rowIndex);
        // ✅ V13: registra log
        registrarLogAcesso_(tel, acesso.id, acesso.apelido, navegador, 'token', acesso.tipoAcesso || 'Cliente');
        return {
          ok: true, modo: acesso.tipoAcesso === 'Admin' ? 'admin' : 'token',
          telefone: tel, nome: clienteNome,
          apelido: acesso.apelido,
          tipoAcesso: acesso.tipoAcesso || 'Cliente'
        };
      }
    }

    if (senhaInformada) {
      if (verificaBloqueio(tel, deviceToken)) {
        return { ok: false, error: 'Muitas tentativas. Aguarde 30 minutos.' };
      }
      const acesso = buscarAcessoPorSenha(tel, senhaInformada);
      if (!acesso) {
        registrarTentativa(tel, deviceToken, navegador, 'Senha incorreta');
        return { ok: false, error: 'Senha incorreta.' };
      }
      if (acesso.status === 'Bloqueado') {
        return { ok: false, error: 'Este acesso está bloqueado.' };
      }
      const novoToken = gerarToken();
      atualizarTokenAcesso(acesso.rowIndex, novoToken, navegador);
      registrarTentativa(tel, deviceToken, navegador, 'Login OK');
      // ✅ V13: registra log
      registrarLogAcesso_(tel, acesso.id, acesso.apelido, navegador, 'senha', acesso.tipoAcesso || 'Cliente');
      return {
        ok: true, modo: acesso.tipoAcesso === 'Admin' ? 'admin' : 'senha',
        telefone: tel, nome: clienteNome,
        apelido: acesso.apelido, deviceToken: novoToken,
        acessoId: acesso.id,
        tipoAcesso: acesso.tipoAcesso || 'Cliente'
      };
    }

    return { ok: false, error: 'Informe a senha de acesso.' };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

function buscarAcessoPorToken(telefone, deviceToken) {
  const sh = getSheet(SHEET_ACESSOS);
  const last = sh.getLastRow();
  if (last < 2) return null;
  const data = sh.getRange(2, 1, last - 1, sh.getLastColumn()).getValues();
  for (let i = 0; i < data.length; i++) {
    const row = data[i];
    if (normalizaTel(row[1]) !== normalizaTel(telefone)) continue;
    if (String(row[4]) === deviceToken) {
      return {
        id: String(row[0]),
        apelido: String(row[2] || ''),
        status: String(row[6] || ''),
        tipoAcesso: String(row[9] || 'Cliente'),
        rowIndex: i + 2
      };
    }
  }
  return null;
}

function buscarAcessoPorSenha(telefone, senha) {
  const sh = getSheet(SHEET_ACESSOS);
  const last = sh.getLastRow();
  if (last < 2) return null;
  const data = sh.getRange(2, 1, last - 1, sh.getLastColumn()).getValues();
  for (let i = 0; i < data.length; i++) {
    const row = data[i];
    if (normalizaTel(row[1]) !== normalizaTel(telefone)) continue;
    if (String(row[3]).toUpperCase() === senha) {
      return {
        id: String(row[0]),
        apelido: String(row[2] || ''),
        status: String(row[6] || 'Ativo'),
        tipoAcesso: String(row[9] || 'Cliente'),
        rowIndex: i + 2
      };
    }
  }
  return null;
}

function atualizarTokenAcesso(rowIndex, novoToken, navegador) {
  const sh = getSheet(SHEET_ACESSOS);
  sh.getRange(rowIndex, 5).setValue(novoToken);
  sh.getRange(rowIndex, 6).setValue(navegador || '');
  sh.getRange(rowIndex, 7).setValue('Ativo');
  sh.getRange(rowIndex, 9).setValue(new Date());
}

function atualizarUltimoAcesso(rowIndex) {
  getSheet(SHEET_ACESSOS).getRange(rowIndex, 9).setValue(new Date());
}

function verificaBloqueio(telefone, deviceId) {
  const sh = getSheet(SHEET_TENTATIVAS);
  const last = sh.getLastRow();
  if (last < 2) return false;
  const limite = new Date(Date.now() - BLOQUEIO_MINUTOS * 60 * 1000);
  const data = sh.getRange(2, 1, last - 1, 6).getValues();
  let erros = 0;
  for (let i = data.length - 1; i >= 0; i--) {
    const row = data[i];
    if (normalizaTel(row[1]) !== normalizaTel(telefone)) continue;
    if (String(row[2]) !== String(deviceId)) continue;
    const dt = new Date(row[4]);
    if (dt < limite) break;
    if (String(row[5]).includes('Senha incorreta')) erros++;
    if (String(row[5]) === 'Login OK') return false;
  }
  return erros >= MAX_TENTATIVAS;
}

function registrarTentativa(telefone, deviceId, navegador, resultado) {
  getSheet(SHEET_TENTATIVAS).appendRow([
    Utilities.getUuid(),
    telefone || '', deviceId || '', navegador || '',
    new Date(), resultado || ''
  ]);
}


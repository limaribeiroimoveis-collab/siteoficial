function apiSalvarImovel(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }

    const sh = getSheet(SHEET_IMOVEIS);
    const id = payload.id || Utilities.getUuid();
    const tel = normalizaTel(payload.telefone || '');
    const codigo = extrairCodigoImovel(payload.link || '');
    const link = String(payload.link || '');

    const rua = String(payload.rua || '').trim();
    const numero = String(payload.numero || '').trim();
    const bairro = String(payload.bairro || '').trim();
    const tituloFinal = montarTitulo_(rua, numero, bairro) || String(payload.titulo || '').trim();

    const last = sh.getLastRow();
    let rowIndex = -1;
    let rowAntiga = null;

    if (last >= 2) {
      const ids = sh.getRange(2, 1, last - 1, 1).getValues();
      for (let i = 0; i < ids.length; i++) {
        if (String(ids[i][0]) === String(id)) {
          rowIndex = i + 2;
          rowAntiga = sh.getRange(rowIndex, 1, 1, 26).getValues()[0];
          break;
        }
      }
    }

    if (rowIndex < 0 && tel) {
      if (last >= 2) {
        const dados = sh.getRange(2, 1, last - 1, 10).getValues();
        for (let i = 0; i < dados.length; i++) {
          const r = dados[i];
          if (!r[0]) continue;
          if (normalizaTel(r[1]) !== tel) continue;
          const codigoExist = String(r[9] || '').trim();
          const linkExist = String(r[4] || '').trim();
          const codigoBate = codigo && codigoExist && codigo === codigoExist;
          const linkBate = link && linkExist && link === linkExist;
          if (codigoBate || linkBate) {
            return {
              ok: false,
              error: 'Você já colocou este imóvel na vitrine deste cliente antes. Não é possível adicionar novamente.'
            };
          }
        }
      }
    }

    const rowData = [
      id, tel, tituloFinal,
      payload.descricao || '', link,
      payload.imagem || '',
      payload.status || 'pendente',
      payload.observacao || '',
      rowAntiga ? rowAntiga[8]  : new Date(),
      codigo,
      rowAntiga ? rowAntiga[10] : '',
      rowAntiga ? rowAntiga[11] : '',
      rowAntiga ? rowAntiga[12] : 'Não',
      rowAntiga ? rowAntiga[13] : '',
      rowAntiga ? rowAntiga[14] : '',
      rowAntiga ? rowAntiga[15] : '',
      rowAntiga ? rowAntiga[16] : '',
      new Date(),
      payload.chaveTexto || (rowAntiga ? rowAntiga[18] : ''),
      rua, numero, bairro,
      payload.preco || '',
      payload.condominio || '',
      payload.iptu || '',
      rowAntiga ? rowAntiga[25] : ''
    ];

    if (rowIndex > 0) sh.getRange(rowIndex, 1, 1, rowData.length).setValues([rowData]);
    else sh.appendRow(rowData);

    registrarHistoricoImovel_(id, rowIndex > 0 ? 'imóvel editado' : 'imóvel adicionado', tel, 'admin');
    if (tel) {
      registrarHistoricoCliente_(tel, 'admin',
        rowIndex > 0 ? 'editou imóvel' : 'adicionou imóvel',
        (tituloFinal || '') + (codigo ? ' #' + codigo : ''), 'admin');
      atualizarDataAcao_(tel, 'admin');
    }
    return { ok: true, id, codigo };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}


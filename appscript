function apiSalvarCliente(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }
    const tel = normalizaTel(payload.telefone);
    if (!tel) return { ok: false, error: 'Telefone vazio' };
    if (!payload.nome || !String(payload.nome).trim()) {
      return { ok: false, error: 'Informe o nome do cliente' };
    }

    const sh = getSheet(SHEET_CLIENTES);
    const last = sh.getLastRow();
    let rowIndex = -1;
    let dadosAntigos = null;
    if (last >= 2) {
      const data = sh.getRange(2, 1, last - 1, 14).getValues();
      for (let i = 0; i < data.length; i++) {
        if (normalizaTel(data[i][0]) === tel) {
          rowIndex = i + 2;
          dadosAntigos = data[i];
          break;
        }
      }
    }

    const isNovo = rowIndex < 0;

    const rowData = [
      tel,
      String(payload.nome).trim(),
      payload.corretor || '',
      payload.parceria || (dadosAntigos ? dadosAntigos[3] : ''),
      payload.tqc || '',
      payload.car || '',
      payload.inativo || '',
      payload.linkVitrine || '',
      payload.observacao || '',
      isNovo ? new Date() : (dadosAntigos[9] || new Date()),
      isNovo ? '' : (dadosAntigos[10] || ''),
      isNovo ? '' : (dadosAntigos[11] || ''),
      isNovo ? (payload.quenteManual || '') : (dadosAntigos[12] || ''),
      isNovo ? (payload.temperaturaManual || '') : (dadosAntigos[13] || '')
    ];

    if (isNovo) sh.appendRow(rowData);
    else sh.getRange(rowIndex, 1, 1, rowData.length).setValues([rowData]);

    registrarHistoricoCliente_(tel, 'admin',
      isNovo ? 'cadastrou cliente' : 'editou cadastro', '', 'admin');
    atualizarDataAcao_(tel, 'admin');

    let acessoInfo = null;
    if (isNovo) {
      try { acessoInfo = criarAcessoAutomatico_(tel, payload.nome); }
      catch (e) { Logger.log('Erro ao criar acesso automático: ' + e.message); }
    }

    return {
      ok: true,
      criado: isNovo,
      apelido: acessoInfo ? acessoInfo.apelido : '',
      senha: acessoInfo ? acessoInfo.senha : ''
    };
  } catch (err) { return { ok: false, error: err.message }; }
}

function criarAcessoAutomatico_(telefone, nome) {
  const tel = normalizaTel(telefone);
  const base = primeiroNome(nome);

  const shAce = getSheet(SHEET_ACESSOS);
  const last = shAce.getLastRow();
  let apelido = base;
  let contador = 2;
  if (last >= 2) {
    const apelidosExistentes = shAce.getRange(2, 3, last - 1, 1).getValues()
      .map(r => String(r[0] || '').trim().toLowerCase());
    while (apelidosExistentes.indexOf(apelido.toLowerCase()) !== -1) {
      apelido = base + contador;
      contador++;
      if (contador > 99) break;
    }
  }

  let senha = gerarSenha();
  let t = 0;
  while (senhaJaExiste(senha) && t < 20) { senha = gerarSenha(); t++; }

  const id = Utilities.getUuid();
  shAce.appendRow([id, tel, apelido, senha, '', '', 'Ativo', new Date(), '', 'Cliente']);

  registrarHistoricoCliente_(tel, 'admin', 'criou acesso automático', 'apelido: ' + apelido, 'admin');
  return { id, apelido, senha };
}


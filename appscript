      return { ok: false, error: 'Senha incorreta' };
    }
    const tel = normalizaTel(payload.telefone);
    if (!tel) return { ok: false, error: 'Telefone vazio' };

    const sh = getSheet(SHEET_HIST_CLIENTE);
    const last = sh.getLastRow();
    if (last < 2) return { ok: true, data: [] };

    const data = sh.getRange(2, 1, last - 1, 6).getValues();
    const out = [];
    for (let i = 0; i < data.length; i++) {
      const row = data[i];
      if (normalizaTel(row[0]) !== tel) continue;
      out.push({
        telefone: String(row[0]),
        dataHora: toISO(row[1]),
        origem: String(row[2] || ''),
        acao: String(row[3] || ''),
        detalhe: String(row[4] || ''),
        apelido: String(row[5] || '')
      });
    }
    out.sort((a, b) => new Date(b.dataHora) - new Date(a.dataHora));
    return { ok: true, data: out };
  } catch (err) { return { ok: false, error: err.message }; }
}

/* =====================================================
   CORREÇÕES
===================================================== */
function apiListarCorrecoes(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }

    const resolvidas = {};
    const shRes = getSheet(SHEET_CORRECOES_RESOLVIDAS);
    const lastRes = shRes.getLastRow();
    if (lastRes >= 2) {
      const dadosRes = shRes.getRange(2, 1, lastRes - 1, 6).getValues();
      dadosRes.forEach(row => {
        const tipo = String(row[1] || '').trim();
        const tel = normalizaTel(row[2]);
        const imId = String(row[3] || '').trim();
        const quando = row[5];
        const chave = tipo + '||' + tel + '||' + imId;
        resolvidas[chave] = { ts: quando ? new Date(quando).getTime() : 0 };
      });
    }

    const estaResolvida = (tipo, tel, imId) => {
      const chave = String(tipo) + '||' + normalizaTel(tel) + '||' + String(imId || '');
      const res = resolvidas[chave];
      if (!res) return false;
      if (tipo === 'CLIENTE_QUENTE_SEM_VISITA') {
        const diasDesde = (Date.now() - res.ts) / 86400000;
        if (diasDesde > 10) return false;
      }
      return true;
    };

    const correcoes = [];

    const shCli = getSheet(SHEET_CLIENTES);
    const lastCli = shCli.getLastRow();
    const clientes = lastCli >= 2 ? shCli.getRange(2, 1, lastCli - 1, 14).getValues() : [];
    const clientesMap = {};
    clientes.forEach(row => {
      const tel = normalizaTel(row[0]);
      if (!tel) return;
      clientesMap[tel] = {
        telefone: tel, nome: String(row[1] || ''),
        corretor: String(row[2] || ''),
        inativo: String(row[6] || ''),
        temperaturaManual: String(row[13] || '')
      };
    });

    const shIm = getSheet(SHEET_IMOVEIS);
    const lastIm = shIm.getLastRow();
    const imoveis = lastIm >= 2 ? shIm.getRange(2, 1, lastIm - 1, 26).getValues() : [];

    const duplicados = {};
    imoveis.forEach(row => {
      if (!row[0]) return;
      const tel = normalizaTel(row[1]);
      const titulo = String(row[2] || '');
      const link = String(row[4] || '');
      const codigo = String(row[9] || '').trim();
      const desativado = String(row[16] || '').toLowerCase() === 'sim';
      const id = String(row[0]);
      const dataAgendada = row[15];
      const clienteNome = (clientesMap[tel] && clientesMap[tel].nome) || '(sem cadastro)';
      const numero = String(row[20] || '');
      const preco = String(row[22] || '');
      const chaveTexto = String(row[18] || '');

      if (codigo && !desativado) {
        const chave = tel + '||' + codigo;
        if (!duplicados[chave]) duplicados[chave] = [];
        duplicados[chave].push({ id, titulo, codigo });
      }
      if (!codigo && !estaResolvida('IMOVEL_SEM_CODIGO', tel, id)) {
        correcoes.push({
          tipo: 'IMOVEL_SEM_CODIGO', severidade: 'media',
          mensagem: 'Imóvel "' + titulo + '" do cliente ' + clienteNome + ' está sem código.',
          telefone: tel, imovelId: id
        });
      }
      if (!link && !estaResolvida('IMOVEL_SEM_LINK', tel, id)) {
        correcoes.push({
          tipo: 'IMOVEL_SEM_LINK', severidade: 'media',
          mensagem: 'Imóvel "' + titulo + '" do cliente ' + clienteNome + ' está sem link de anúncio.',
          telefone: tel, imovelId: id
        });
      }
      if (!numero && !estaResolvida('IMOVEL_SEM_NUMERO', tel, id)) {
        correcoes.push({
          tipo: 'IMOVEL_SEM_NUMERO', severidade: 'baixa',
          mensagem: 'Imóvel "' + titulo + '" (' + clienteNome + ') está sem número. Edite o imóvel ou agende uma visita com número.',
          telefone: tel, imovelId: id
        });
      }
      if (!preco && !estaResolvida('IMOVEL_SEM_PRECO', tel, id)) {
        correcoes.push({
          tipo: 'IMOVEL_SEM_PRECO', severidade: 'baixa',
          mensagem: 'Imóvel "' + titulo + '" (' + clienteNome + ') está sem preço.',
          telefone: tel, imovelId: id
        });
      }
      if (!chaveTexto && !desativado && !estaResolvida('IMOVEL_SEM_CHAVE', tel, id)) {
        correcoes.push({
          tipo: 'IMOVEL_SEM_CHAVE', severidade: 'baixa',
          mensagem: 'Imóvel "' + titulo + '" (' + clienteNome + ') está sem texto de chave. Agende uma visita com o texto da chave.',
          telefone: tel, imovelId: id
        });
      }
      if (desativado && dataAgendada && !estaResolvida('IMOVEL_DESATIVADO_COM_AGENDAMENTO', tel, id)) {
        correcoes.push({
          tipo: 'IMOVEL_DESATIVADO_COM_AGENDAMENTO', severidade: 'baixa',
          mensagem: 'Imóvel "' + titulo + '" (' + clienteNome + ') está desativado mas ainda tem visita agendada.',
          telefone: tel, imovelId: id
        });
      }
      if (dataAgendada && !desativado) {
        const dtAg = new Date(dataAgendada);
        const visitaFeita = String(row[12] || '').toLowerCase() === 'sim';
        if (!isNaN(dtAg.getTime()) && (Date.now() - dtAg.getTime()) > 2 * 60 * 60 * 1000 && !visitaFeita) {
          if (!estaResolvida('AGENDAMENTO_PASSADO', tel, id)) {
            correcoes.push({
              tipo: 'AGENDAMENTO_PASSADO', severidade: 'baixa',
              mensagem: 'Imóvel "' + titulo + '" (' + clienteNome + ') tinha visita agendada para ' +
                Utilities.formatDate(dtAg, 'America/Sao_Paulo', 'dd/MM/yyyy HH:mm') +
                ' e ainda não foi registrada. Registre ou cancele.',
              telefone: tel, imovelId: id
            });
          }
        }
      }
      if (dataAgendada && clientesMap[tel] && clientesMap[tel].inativo.toLowerCase() === 'sim') {
        const dtAg = new Date(dataAgendada);
        if (!isNaN(dtAg.getTime()) && dtAg.getTime() > Date.now()) {
          if (!estaResolvida('CLIENTE_INATIVO_COM_AGENDAMENTO', tel, id)) {
            correcoes.push({
              tipo: 'CLIENTE_INATIVO_COM_AGENDAMENTO', severidade: 'baixa',
              mensagem: 'Cliente ' + clienteNome + ' está inativo, mas tem visita agendada para ' +
                Utilities.formatDate(dtAg, 'America/Sao_Paulo', 'dd/MM/yyyy HH:mm') +
                ' no imóvel "' + titulo + '".',
              telefone: tel, imovelId: id
            });
          }
        }
      }
    });

    Object.keys(duplicados).forEach(chave => {
      const lista = duplicados[chave];
      if (lista.length < 2) return;
      const tel = chave.split('||')[0];
      const imId = lista[0].id;
      if (estaResolvida('IMOVEL_DUPLICADO', tel, imId)) return;
      const clienteNome = (clientesMap[tel] && clientesMap[tel].nome) || '(sem cadastro)';
      correcoes.push({
        tipo: 'IMOVEL_DUPLICADO', severidade: 'alta',
        mensagem: 'Cliente ' + clienteNome + ' tem o imóvel #' + lista[0].codigo +
          ' cadastrado ' + lista.length + ' vezes. Exclua os duplicados.',
        telefone: tel, imovelId: imId,
        ids: lista.map(x => x.id)
      });
    });

    clientes.forEach(row => {
      const tel = normalizaTel(row[0]);
      if (!tel) return;
      const nome = String(row[1] || '').trim();
      const corretor = String(row[2] || '').trim();
      const tempManual = String(row[13] || '').toLowerCase() === 'sim';
      const quenteManual = String(row[12] || '').toLowerCase();

      if (!nome && !estaResolvida('CLIENTE_SEM_NOME', tel, '')) {
        correcoes.push({
          tipo: 'CLIENTE_SEM_NOME', severidade: 'media',
          mensagem: 'Cliente com telefone ' + tel + ' está sem nome cadastrado.',
          telefone: tel
        });
      }
      if (!corretor && !estaResolvida('CLIENTE_SEM_CORRETOR', tel, '')) {
        correcoes.push({
          tipo: 'CLIENTE_SEM_CORRETOR', severidade: 'media',
          mensagem: 'Cliente ' + (nome || tel) + ' não tem corretor atribuído.',
          telefone: tel
        });
      }

      if (tempManual && quenteManual === 'quente') {
        const ult = ultimaVisitaConcluidaDoCliente_(tel);
        let dias = 999;
        if (ult) {
          dias = Math.floor((Date.now() - new Date(ult).getTime()) / 86400000);
        }
        if (dias > 10 && !estaResolvida('CLIENTE_QUENTE_SEM_VISITA', tel, '')) {
          correcoes.push({
            tipo: 'CLIENTE_QUENTE_SEM_VISITA', severidade: 'media',
            mensagem: 'Cliente ' + (nome || tel) + ' está marcado como 🔥 Quente manualmente, mas há ' +
              (ult ? dias + ' dias' : 'nenhuma visita concluída') + ' sem visita. Aceite como morno ou prorrogue.',
            telefone: tel,
            acoes: ['aceitarMorno', 'prorrogarQuente']
          });
        }
      }
    });

    const shAce = getSheet(SHEET_ACESSOS);
    const lastAce = shAce.getLastRow();
    const acessos = lastAce >= 2 ? shAce.getRange(2, 1, lastAce - 1, shAce.getLastColumn()).getValues() : [];

    const telComAcesso = {};
    acessos.forEach(row => {
      const tel = normalizaTel(row[1]);
      if (!tel) return;
      telComAcesso[tel] = true;
      if (!clientesMap[tel]) {
        const acessoId = String(row[0]);
        if (!estaResolvida('ACESSO_SEM_CLIENTE', tel, acessoId)) {
          correcoes.push({
            tipo: 'ACESSO_SEM_CLIENTE', severidade: 'baixa',
            mensagem: 'Acesso "' + String(row[2] || '') + '" está vinculado ao telefone ' + tel +
              ', mas não existe cliente com esse número.',
            telefone: tel, acessoId: acessoId
          });
        }
      }
    });

    clientes.forEach(row => {
      const tel = normalizaTel(row[0]);
      if (!tel) return;
      if (!telComAcesso[tel] && !estaResolvida('CLIENTE_SEM_ACESSO', tel, '')) {
        correcoes.push({
          tipo: 'CLIENTE_SEM_ACESSO', severidade: 'media',
          mensagem: 'Cliente ' + (String(row[1] || '') || tel) + ' não tem nenhum acesso criado.',
          telefone: tel
        });
      }
    });

    const ordem = { alta: 0, media: 1, baixa: 2 };
    correcoes.sort((a, b) => (ordem[a.severidade] || 9) - (ordem[b.severidade] || 9));

    return { ok: true, data: correcoes, total: correcoes.length };
  } catch (err) { return { ok: false, error: err.message }; }
}


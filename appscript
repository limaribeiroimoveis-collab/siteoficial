/* =====================================================
   ✅ V17 — CAPTAÇÕES: CONTAR PENDENTES
   Rota pública (sem senha) — usada pelo gestor para o balão.
   Conta quantas captações têm "ContatoFeito" vazio
   (ou seja, ainda não foram trabalhadas pelo corretor).
===================================================== */
function apiContarCaptacoesPendentes(payload) {
  try {
    const sh = getSheet(SHEET_CAPTACOES);
    const last = sh.getLastRow();
    if (last < 2) return { ok: true, pendentes: 0, total: 0 };

    const lastCol = sh.getLastColumn();
    const headers = sh.getRange(1, 1, 1, lastCol).getValues()[0]
      .map(h => String(h || '').trim());
    const idxContatoFeito = headers.indexOf('ContatoFeito'); // 0-based

    // Se a coluna não existir (migração V19 não rodada), fallback para Concluida
    const idxConcluida = headers.indexOf('Concluida');

    const data = sh.getRange(2, 1, last - 1, lastCol).getValues();
    let pendentes = 0;
    let total = 0;

    for (let i = 0; i < data.length; i++) {
      const row = data[i];
      if (!row[0]) continue;
      total++;

      if (idxContatoFeito >= 0) {
        // Nova regra: conta só quem tem ContatoFeito vazio
        const contato = String(row[idxContatoFeito] || '').trim().toLowerCase();
        if (contato === '') pendentes++;
      } else if (idxConcluida >= 0) {
        // Fallback antigo: conta quem não está marcado como concluída
        const concluida = String(row[idxConcluida] || '').trim().toLowerCase();
        if (concluida !== 'sim') pendentes++;
      } else {
        // Sem nenhuma coluna de status — considera tudo pendente
        pendentes++;
      }
    }

    return { ok: true, pendentes, total };
  } catch (err) {
    return { ok: false, error: err.message };
  }
}


  if (last < 2) { Logger.log('Sem linhas'); return; }
  const dados = sh.getRange(2, 1, last - 1, 26).getValues();
  const paraExcluir = [];
  dados.forEach((row, i) => {
    if (normalizaTel(row[1]) !== destinoNorm) return;
    const minutos = (Date.now() - new Date(row[8]).getTime()) / 60000;
    if (minutos < 10) paraExcluir.push({ idx: i + 2, titulo: row[2] });
  });
  if (paraExcluir.length === 0) { Logger.log('Nada pra apagar'); return; }
  paraExcluir.sort((a,b) => b.idx - a.idx).forEach(x => sh.deleteRow(x.idx));
  Logger.log('✅ ' + paraExcluir.length + ' linha(s) apagada(s)');
}


===================================================== */
function apiListarTarefas(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }
    const sh = getSheet(SHEET_TAREFAS);
    const last = sh.getLastRow();
    if (last < 2) return { ok: true, data: [] };

    const data = sh.getRange(2, 1, last - 1, 7).getValues();
    const out = [];
    for (let i = 0; i < data.length; i++) {
      const row = data[i];
      if (!row[0]) continue;
      const ordem = row[6] === '' || row[6] === null || row[6] === undefined
        ? (i + 1) : Number(row[6]) || (i + 1);
      out.push({
        id: String(row[0]),
        texto: String(row[1] || ''),
        corretor: String(row[2] || ''),
        status: String(row[3] || 'pendente'),
        dataCriacao: toISO(row[4]),
        dataConclusao: toISO(row[5]),
        ordem: ordem
      });
    }
    // Ordena: pendentes primeiro, por ordem; concluídas depois, por dataConclusao
    out.sort((a, b) => {
      if(a.status !== b.status){
        return a.status === 'pendente' ? -1 : 1;
      }
      if(a.status === 'pendente') return a.ordem - b.ordem;
      return new Date(b.dataConclusao || 0) - new Date(a.dataConclusao || 0);
    });
    return { ok: true, data: out };
  } catch (err) { return { ok: false, error: err.message }; }
}


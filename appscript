function apiCriarAcesso(payload) {
  try {
    if (!payload.senha || payload.senha !== getConfig('admin_senha')) {
      return { ok: false, error: 'Senha incorreta' };
    }
    const tel = normalizaTel(payload.telefone);
    let apelido = String(payload.apelido || '').trim();
    const tipoAcesso = String(payload.tipoAcesso || 'Cliente').trim();
    if (!tel) return { ok: false, error: 'Telefone vazio' };

    const shCli = getSheet(SHEET_CLIENTES);
    const lastCli = shCli.getLastRow();
    let existe = false, nomeCli = '';
    if (lastCli >= 2) {
      const clientes = shCli.getRange(2, 1, lastCli - 1, 2).getValues();
      for (let i = 0; i < clientes.length; i++) {
        if (normalizaTel(clientes[i][0]) === tel) { existe = true; nomeCli = String(clientes[i][1] || ''); break; }
      }
    }
    if (!existe) return { ok: false, error: 'Cadastre o cliente antes de criar acessos.' };

    if (!apelido) apelido = primeiroNome(nomeCli);

    let senha = gerarSenha();
    let t = 0;
    while (senhaJaExiste(senha) && t < 20) { senha = gerarSenha(); t++; }

    const id = Utilities.getUuid();
    getSheet(SHEET_ACESSOS).appendRow([
      id, tel, apelido, senha, '', '', 'Ativo', new Date(), '', tipoAcesso
    ]);

    registrarHistoricoCliente_(tel, 'admin', 'criou acesso',
      'apelido: ' + apelido + ' (' + tipoAcesso + ')', 'admin');
    atualizarDataAcao_(tel, 'admin');

    return { ok: true, id, senha, apelido, tipoAcesso };
  } catch (err) { return { ok: false, error: err.message }; }
}

function senhaJaExiste(senha) {
  const sh = getSheet(SHEET_ACESSOS);
